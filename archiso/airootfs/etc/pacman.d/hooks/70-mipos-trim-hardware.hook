# mipOS: after a kernel or firmware install/update, delete the drivers and
# firmware this laptop doesn't use (lists: /etc/mipos/keep-modules and
# /etc/mipos/keep-firmware). Runs after depmod (60-...) and before the
# start-up system (initramfs) is built (90-mkinitcpio-...).
# Stays on the live and the installed system.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = linux
Target = linux-firmware*
Target = sof-firmware
Target = intel-ucode

[Action]
Description = Removing drivers and firmware this laptop doesn't use...
When = PostTransaction
Depends = kmod
Depends = findutils
Exec = /usr/local/sbin/mipos-trim-hardware
