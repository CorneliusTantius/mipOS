# remove from airootfs!
# Build-time only: put mipOS's name into /etc/os-release.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem

[Action]
Description = Writing mipOS /etc/os-release...
When = PostTransaction
Exec = /usr/bin/sh -c "rm -f /etc/os-release && cp /usr/share/mipos/os-release /etc/os-release"
