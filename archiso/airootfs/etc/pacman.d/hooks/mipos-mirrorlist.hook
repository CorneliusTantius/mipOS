# remove from airootfs!
# Build-time only: put Arch's worldwide mirror (it picks a server near you)
# at the top of the mirror list, so pacman works on the live and installed system.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = pacman-mirrorlist

[Action]
Description = Adding the geo mirror to /etc/pacman.d/mirrorlist...
When = PostTransaction
Depends = sed
Exec = /usr/bin/sed -i '1i Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' /etc/pacman.d/mirrorlist
