# mipOS: after a kernel or Intel firmware install/update, delete Intel Wi-Fi
# firmware versions the kernel can't use (keeps the two newest usable per chip).
# Stays on the live and the installed system.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = linux
Target = linux-lts
Target = linux-zen
Target = linux-firmware-intel

[Action]
Description = Removing Intel Wi-Fi firmware versions the kernel can't use...
When = PostTransaction
Depends = kmod
Exec = /usr/local/sbin/mipos-trim-wifi-firmware
