#!/usr/bin/env bash
# =====================================================================
#  monarch-install: the monarch text installer (runs on the live ISO)
#
#  Usage:
#    monarch-install                      ask everything with menus
#    monarch-install --config FILE        unattended: answers from FILE
#                                       (example: /usr/share/monarch/answers.example)
#    monarch-install --dry-run            ask everything, show the summary,
#                                       change nothing
#
#  Screens are drawn with plain bash and terminal colors (nothing extra to install).
#  Steps: network, language and keyboard, timezone, computer name, user,
#  disk, encryption, desktop (optional), summary (type "yes"), install. Nothing on any disk
#  changes before you confirm the summary.
#
#  How it installs: it copies the live system (the files you are running
#  right now) to the disk, then turns it into an installed system: users,
#  boot loader, encryption, hibernation, removing live-only settings.
#  So it works without internet; with internet it can update afterwards.
# =====================================================================
set -Eeuo pipefail

CONF=${MONARCH_CONF:-/usr/share/monarch/monarch.conf}
# shellcheck source=/dev/null
source "${CONF}"

LOG=/var/log/monarch-install.log
TARGET=/mnt/monarch                 # where the new system is mounted
LIVE_ROOT=/run/archiso/airootfs   # the untouched live system image
CRYPT_NAME=cryptroot
MIN_ROOT_GB=12                    # space for the system itself (besides swap)
EFI_TYPE=ef00                     # sgdisk code: EFI system partition
ROOT_TYPE=8304                    # sgdisk code: Linux x86-64 root
ESP_OPTS="fmask=0137,dmask=0027"  # EFI partition: only root may change it
TITLE="${DISTRO_NAME} ${DISTRO_VERSION} installer"
UNATTENDED=no
DRY_RUN=no
STEP_TOTAL=9

declare -A ANS=()                 # answers (from menus or the --config file)

# ---------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------
log()  { printf '[%s] %s\n' "$(date +%T)" "$*" >>"${LOG}"; }
run()  { log "+ $*"; "$@" >>"${LOG}" 2>&1; }      # run a command, output to the log

# ---------------------------------------------------------------------
# Screens: plain bash and terminal color codes, nothing extra to install.
# Everything is drawn on /dev/tty; answers are printed on stdout.
# Only characters the plain text console can show are used.
# ---------------------------------------------------------------------
INTERACTIVE=no                    # set in main(): yes when a person is at the screen
UI_INT=0                          # set to 1 by Ctrl+C
MAIN_PID=$$
E=$'\e'
ACC="${E}[1;36m"; OK="${E}[32m"; ERR="${E}[1;31m"; WARN="${E}[1;33m"
DIM="${E}[2m"; BOLD="${E}[1m"; REV="${E}[7m"; RST="${E}[0m"
UI_W=76                           # text width

interactive() { [[ ${INTERACTIVE} == yes ]]; }
tty_out() { printf '%s' "$*" >/dev/tty; }
ui_restore() {   # cursor visible, colors off: also after errors
    interactive && printf '%s' "${E}[?25h${RST}" >/dev/tty 2>/dev/null
    return 0
}

cols() {   # terminal width, at most 100
    local c
    c="$(stty size </dev/tty 2>/dev/null | awk '{print $2}')"
    [[ ${c:-0} -gt 20 ]] || c=80
    (( c > 100 )) && c=100
    echo "${c}"
}

paint() {   # paint COLOR text... : one wrapped paragraph per argument
    local color=$1 p l
    shift
    for p in "$@"; do
        if interactive; then
            while IFS= read -r l; do tty_out "  ${color}${l}${RST}"$'\n'; done < <(printf '%s\n' "${p}" | fold -s -w "${UI_W}")
        else
            printf '%s\n' "${p}"
        fi
    done
}
say()  { paint "" "$@"; }
dim()  { paint "${DIM}" "$@"; }
good() { paint "${OK}" "[ok] $*"; }
bad()  { paint "${ERR}" "$*"; }
warn() { paint "${WARN}" "$*"; }
blank() { interactive && echo >/dev/tty; return 0; }

hline() { local l; printf -v l '%*s' "$1" ''; printf '%s' "${l// /$2}"; }

box() {   # box COLOR line... : lines in a frame
    local color=$1 l w=0
    shift
    for l in "$@"; do (( ${#l} > w )) && w=${#l}; done
    tty_out "  ${color}┌$(hline $((w + 2)) ─)┐${RST}"$'\n'
    for l in "$@"; do tty_out "  ${color}│${RST} $(printf "%-${w}s" "${l}") ${color}│${RST}"$'\n'; done
    tty_out "  ${color}└$(hline $((w + 2)) ─)┘${RST}"$'\n'
}

# The top of every screen: installer name, step, and a progress strip.
header() {   # header N "Title"
    if ! interactive; then echo "== Step $1 of ${STEP_TOTAL}: $2"; return; fi
    local strip="" i
    for ((i = 1; i <= STEP_TOTAL; i++)); do
        if (( i <= $1 )); then strip+="${ACC}■${RST}"; else strip+="${DIM}·${RST}"; fi
    done
    tty_out "${E}[H${E}[2J"$'\n'
    box "${ACC}" "${TITLE}"
    tty_out $'\n'"  ${strip}  ${DIM}Step $1 of ${STEP_TOTAL}${RST}"$'\n'
    tty_out "  ${BOLD}$2${RST}"$'\n\n'
}

pause() { interactive || return 0; tty_out $'\n'"  ${DIM}Press Enter to continue${RST}"; read -r -s _ </dev/tty || true; tty_out $'\n'; }

# Read one key. Sets KEY to up/down/left/right/pgup/pgdown/home/end/enter/
# esc/backspace/tab/int (Ctrl+C), or the typed character.
read_key() {
    local k c2 c3
    local rc
    KEY=""
    # Wait in short slices, so a Ctrl+C (which sets UI_INT) is noticed.
    while true; do
        if IFS= read -r -s -n 1 -t 0.2 k </dev/tty; then
            if (( UI_INT )); then UI_INT=0; KEY=int; return; fi   # Ctrl+C came first
            break
        else
            rc=$?                                   # > 128 = no key yet
        fi
        if (( UI_INT )); then UI_INT=0; KEY=int; return; fi
        (( rc > 128 )) || { KEY=int; return; }      # the screen went away
    done
    case "${k}" in
        "${E}")
            if IFS= read -r -s -n 1 -t 0.05 c2 </dev/tty; then
                IFS= read -r -s -n 1 -t 0.05 c3 </dev/tty || c3=""
                case "${c3}" in
                    A) KEY=up ;; B) KEY=down ;; C) KEY=right ;; D) KEY=left ;;
                    H) KEY=home ;; F) KEY=end ;;
                    [0-9]) IFS= read -r -s -n 1 -t 0.05 _ </dev/tty || true   # the "~"
                           case "${c3}" in 5) KEY=pgup ;; 6) KEY=pgdown ;; 1|7) KEY=home ;; 4|8) KEY=end ;; *) KEY=other ;; esac ;;
                    *) KEY=other ;;
                esac
            else
                KEY=esc
            fi ;;
        "") KEY=enter ;;
        $'\x7f'|$'\b') KEY=backspace ;;
        $'\t') KEY=tab ;;
        $'\x03') KEY=int ;;
        *) KEY=${k} ;;
    esac
}

# Esc or Ctrl+C on a question lands here. Quitting stops the whole installer,
# even from inside $( ... ), by signalling the main script.
quit_check() {
    tty_out $'\n'
    if confirm_raw no "Quit the installer? Nothing has been changed on your disks."; then
        tty_out "${E}[H${E}[2J"
        echo "Installer stopped. Nothing was changed." >/dev/tty
        kill -s TERM "${MAIN_PID}"
        exit 1
    fi
}

# list_ui MODE "question" item... -> sets LIST_IDX to the number (0, 1, ...) of the picked item.
# (A variable, not printed output, so menus never run inside each other's $( ).)
# MODE plain: arrows/Enter. MODE search: typing narrows the list.
list_ui() {
    local mode=$1 question=$2 width h=12 q="" cur=0 top=0 drawn=0 i n lq line
    trap 'UI_INT=1' INT   # Ctrl+C: noticed by read_key (also inside $( ))
    shift 2
    local -a items=("$@") shown=()
    width=$(( $(cols) - 6 ))
    tty_out "${E}[?25l"
    while true; do
        shown=()
        lq=${q,,}
        for i in "${!items[@]}"; do
            [[ -z ${lq} || ${items[i],,} == *"${lq}"* ]] && shown+=("${i}")
        done
        n=${#shown[@]}
        (( cur > n - 1 )) && cur=$(( n > 0 ? n - 1 : 0 ))
        (( cur < 0 )) && cur=0
        (( cur < top )) && top=${cur}
        (( cur >= top + h )) && top=$(( cur - h + 1 ))
        (( top > 0 && top + h > n )) && top=$(( n > h ? n - h : 0 ))
        # Draw (go back up over the previous drawing first).
        (( drawn > 0 )) && tty_out "${E}[${drawn}A"
        tty_out $'\r'"${E}[J"
        drawn=0
        tty_out "  ${ACC}${question:0:width}${RST}"$'\n'; drawn=$((drawn + 1))
        if [[ ${mode} == search ]]; then
            tty_out "  Search: ${BOLD}${q}${RST}${ACC}_${RST}"$'\n'; drawn=$((drawn + 1))
        fi
        if (( n == 0 )); then
            tty_out "    ${DIM}(nothing matches \"${q}\")${RST}"$'\n'; drawn=$((drawn + 1))
        fi
        for ((i = top; i < n && i < top + h; i++)); do
            line=${items[shown[i]]:0:width}
            if (( i == cur )); then tty_out "  ${ACC}> ${BOLD}${line}${RST}"$'\n'
            else tty_out "    ${line}"$'\n'; fi
            drawn=$((drawn + 1))
        done
        if [[ ${mode} == search ]]; then
            line="type to search, up/down to move, Enter to pick, Esc to quit"
        else
            line="up/down to move, Enter to pick, Esc to quit"
        fi
        (( n > h )) && line="$((cur + 1))/${n}  ${line}"
        tty_out "  ${DIM}${line:0:width}${RST}"$'\n'; drawn=$((drawn + 1))

        read_key
        case "${KEY}" in
            up)     (( cur > 0 )) && cur=$((cur - 1)) ;;
            down)   (( cur < n - 1 )) && cur=$((cur + 1)) ;;
            pgup)   cur=$((cur - h)) ;;
            pgdown) cur=$((cur + h)); (( cur > n - 1 )) && cur=$((n - 1)) ;;
            home)   cur=0 ;;
            end)    cur=$((n - 1)) ;;
            enter)
                (( n > 0 )) || continue
                tty_out "${E}[${drawn}A"$'\r'"${E}[J"
                tty_out "  ${ACC}${question:0:width}${RST} ${BOLD}${items[shown[cur]]:0:width}${RST}"$'\n'
                tty_out "${E}[?25h"
                LIST_IDX=${shown[cur]}
                return 0 ;;
            esc|int)
                tty_out "${E}[?25h"
                quit_check
                tty_out "${E}[?25l"; drawn=0 ;;
            backspace) [[ ${mode} == search ]] && { q=${q%?}; cur=0; top=0; } ;;
            k) [[ ${mode} == search ]] && { q+=k; cur=0; top=0; } || { (( cur > 0 )) && cur=$((cur - 1)); } ;;
            j) [[ ${mode} == search ]] && { q+=j; cur=0; top=0; } || { (( cur < n - 1 )) && cur=$((cur + 1)); } ;;
            *)
                if [[ ${mode} == search && ${#KEY} -eq 1 && ${KEY} == [[:print:]] ]]; then
                    q+=${KEY}; cur=0; top=0
                fi ;;
        esac
    done
}

# choose "question" value label value label ... -> prints the value
choose() {
    local question=$1 values=() labels=()
    trap 'UI_INT=1' INT
    shift
    while (( $# )); do values+=("$1"); labels+=("$2"); shift 2; done
    list_ui plain "${question}" "${labels[@]}"
    printf '%s' "${values[LIST_IDX]}"
}

# search "question" item... -> prints the picked item
search() {
    local question=$1
    trap 'UI_INT=1' INT
    shift
    list_ui search "${question}" "$@"
    shift $((LIST_IDX))
    printf '%s' "$1"
}

# text_input "question" "start value" -> prints the typed text (line editing works)
text_input() {
    local ans
    trap 'UI_INT=1' INT   # Ctrl+C: noticed by read_key (also inside $( ))
    tty_out "  ${ACC}$1${RST}"$'\n'
    while true; do
        if IFS= read -e -r -i "$2" -p "  > " ans </dev/tty 2>/dev/tty; then
            printf '%s' "${ans}"
            return 0
        fi
        quit_check
        tty_out "  ${ACC}$1${RST}"$'\n'
    done
}

# secret_input "question" -> prints the typed password; shows * for each letter
secret_input() {
    local pw=""
    trap 'UI_INT=1' INT   # Ctrl+C: noticed by read_key (also inside $( ))
    tty_out "  ${ACC}$1${RST}"$'\n'"  > "
    while true; do
        read_key
        case "${KEY}" in
            enter) tty_out $'\n'; printf '%s' "${pw}"; return 0 ;;
            backspace) if [[ -n ${pw} ]]; then pw=${pw%?}; tty_out $'\b \b'; fi ;;
            esc|int) pw=""; quit_check; tty_out "  ${ACC}$1${RST}"$'\n'"  > " ;;
            up|down|left|right|pgup|pgdown|home|end|tab|other) ;;
            *) pw+=${KEY}; tty_out "*" ;;
        esac
    done
}

# confirm_raw DEFAULT(yes|no) "question" [cancel] -> 0 = yes, 1 = no.
# Esc/Ctrl+C: No, or (with "cancel") return 2.
confirm_raw() {
    local sel=$1 y n cancel=${3:-}
    trap 'UI_INT=1' INT   # Ctrl+C: noticed by read_key (also inside $( ))
    paint "${ACC}" "$2"
    tty_out "${E}[?25l"
    while true; do
        if [[ ${sel} == yes ]]; then y="${REV}${ACC}  Yes  ${RST}"; n="${DIM}  No  ${RST}"
        else y="${DIM}  Yes  ${RST}"; n="${REV}${ACC}  No  ${RST}"; fi
        tty_out $'\r'"${E}[K    ${y}   ${n}   ${DIM}left/right, y/n, Enter${RST}"
        read_key
        case "${KEY}" in
            left|right|tab|h|l) [[ ${sel} == yes ]] && sel=no || sel=yes ;;
            y|Y) sel=yes; break ;;
            n|N) sel=no; break ;;
            enter) break ;;
            esc|int)
                if [[ -n ${cancel} ]]; then tty_out $'\r'"${E}[K${E}[?25h"; return 2; fi
                sel=no; break ;;
        esac
    done
    tty_out $'\r'"${E}[K    ${BOLD}$([[ ${sel} == yes ]] && echo Yes || echo No)${RST}"$'\n'"${E}[?25h"
    [[ ${sel} == yes ]]
}

# yesno [--defaultno] "question" -> 0 = yes, 1 = no. Esc/Ctrl+C asks whether to quit.
yesno() {
    local def=yes
    [[ ${1:-} == --defaultno ]] && { def=no; shift; }
    local rc
    while true; do
        if confirm_raw "${def}" "$1" cancel; then rc=0; else rc=$?; fi
        (( rc < 2 )) && return ${rc}
        quit_check
    done
}

# Spinner while a step runs: | / - \ turning in front of the title.
SPIN_PID=""
start_spinner() {
    interactive || { echo "... $1"; return 0; }
    tty_out "${E}[?25l"
    (
        trap - INT TERM
        frames='|/-\' i=0
        while :; do
            printf '\r  %s%s%s %s' "${ACC}" "${frames:i++%4:1}" "${RST}" "$1" >/dev/tty
            sleep 0.15
        done
    ) &
    SPIN_PID=$!
}
stop_spinner() {
    if [[ -n ${SPIN_PID} ]]; then
        kill "${SPIN_PID}" 2>/dev/null || true
        wait "${SPIN_PID}" 2>/dev/null || true
        SPIN_PID=""
        tty_out $'\r'"${E}[K${E}[?25h"
    fi
    return 0
}

# Safety net: a command failed where the installer didn't expect it.
# In the main script: show the error box with the line number. Inside an
# install step or a $( ): only log it; the step itself reports the failure.
on_error() {   # on_error CODE LINE COMMAND
    if [[ ${BASHPID} != "${MAIN_PID}" ]]; then
        log "Failed (code $1) at line $2: $3"
        return 0
    fi
    die "Unexpected error (code $1) at line $2 of monarch-install, while running: $3"
}

ERR_TRAP='on_error $? ${LINENO} "${BASH_COMMAND}"'
safety_net_on()  { if [[ ${BASHPID} == "${MAIN_PID}" ]]; then trap "${ERR_TRAP}" ERR; fi; }
safety_net_off() { trap - ERR; }

# Run "$@" in a subshell that stops at its first error; set RUN_RC to its exit code.
# The safety net is off around it: a failure here is expected and handled by the caller.
run_isolated() {
    safety_net_off
    set +e
    ( trap 'log "Failed (code $?) at line ${LINENO}: ${BASH_COMMAND}"' ERR
      set -Eeuo pipefail
      "$@" )
    RUN_RC=$?
    set -e
    safety_net_on
}

die() {
    trap - ERR
    log "ERROR: $*"
    stop_spinner
    if interactive; then
        tty_out $'\n'
        box "${ERR}" "Installation stopped"
        paint "${ERR}" "$*"
        tty_out $'\n'
        dim "Last lines of the log (${LOG}):"
        tail -n 15 "${LOG}" | cut -c1-100 >/dev/tty
        tty_out $'\n'
        ui_restore
    fi
    echo "ERROR: $*" >&2
    echo "Full log: ${LOG}" >&2
    exit 1
}

# In unattended mode every answer must come from the file.
need() { [[ -n ${ANS[$1]:-} ]] || die "Missing setting ${1} in the answers file."; }

# Partition N of a disk: /dev/sda + 2 = /dev/sda2, /dev/nvme0n1 + 2 = /dev/nvme0n1p2
partdev() { case "$1" in *[0-9]) echo "${1}p$2" ;; *) echo "${1}$2" ;; esac; }

ram_mib() { awk '/MemTotal/ {print int(($2 + 1023) / 1024)}' /proc/meminfo; }
gib() { echo $(( ($1 + 1023) / 1024 )); }   # MiB -> GiB, rounded up

# ---------------------------------------------------------------------
# Answers file (--config): KEY=value lines, read as text (never run)
# ---------------------------------------------------------------------
KEYS="NETWORK WIFI_SSID WIFI_PASSWORD LOCALE KEYMAP TIMEZONE HOSTNAME FULLNAME USERNAME
      PASSWORD DISK MODE ENCRYPT LUKS_PASSWORD DESKTOP UPDATE CONFIRM REBOOT"

load_answers() {
    local line key val
    [[ -r $1 ]] || die "Can't read the answers file $1"
    while IFS= read -r line || [[ -n ${line} ]]; do
        [[ ${line} =~ ^[[:space:]]*(#|$) ]] && continue
        [[ ${line} =~ ^[[:space:]]*([A-Z_]+)=(.*)$ ]] || die "Can't understand this line in $1: ${line}"
        key=${BASH_REMATCH[1]}; val=${BASH_REMATCH[2]}
        if [[ ${val} =~ ^\"(.*)\"[[:space:]]*(#.*)?$ || ${val} =~ ^\'(.*)\'[[:space:]]*(#.*)?$ ]]; then
            val=${BASH_REMATCH[1]}
        else
            val=${val%%[[:space:]]#*}                 # drop a trailing "  # note"
            val=${val%"${val##*[![:space:]]}"}        # drop trailing spaces
        fi
        [[ " ${KEYS//$'\n'/ } " == *" ${key} "* ]] || die "Unknown setting ${key} in $1"
        ANS[${key}]=${val}
    done <"$1"
}

# ---------------------------------------------------------------------
# Checks before starting
# ---------------------------------------------------------------------
preflight() {
    [[ ${EUID} -eq 0 ]] || { echo "Run as root: monarch-install"; exit 1; }
    [[ -d /sys/firmware/efi ]] || { echo "This PC started in old BIOS mode. ${DISTRO_NAME} needs UEFI."; exit 1; }
    [[ -d ${LIVE_ROOT}/usr ]] || { echo "Can't find the live system at ${LIVE_ROOT}. Run this from the ${DISTRO_NAME} ISO."; exit 1; }
    local c
    for c in sgdisk sfdisk partx wipefs mkfs.fat mkfs.btrfs btrfs cryptsetup rsync \
             arch-chroot lsblk blkid findmnt iwctl loadkeys grub-install; do
        command -v "${c}" >/dev/null || { echo "Missing tool: ${c}"; exit 1; }
    done
    mkdir -p "$(dirname "${LOG}")"
    : >"${LOG}"
    chmod 600 "${LOG}"
    log "${TITLE} started (unattended=${UNATTENDED}, dry-run=${DRY_RUN})"
}

# ---------------------------------------------------------------------
# 1. Network
# ---------------------------------------------------------------------
online() { ping -c 1 -W 3 archlinux.org >/dev/null 2>&1; }

wifi_dev() {   # first Wi-Fi interface, e.g. wlan0
    local d
    for d in /sys/class/net/*/wireless; do [[ -e ${d} ]] && { basename "$(dirname "${d}")"; return; }; done
    return 1
}

wait_online() {   # wait up to $1 seconds
    local i
    for ((i = 0; i < $1; i++)); do online && return 0; sleep 1; done
    return 1
}

wifi_connect() {   # wifi_connect DEV SSID PASSWORD(may be empty)
    rfkill unblock wifi 2>/dev/null || true
    if [[ -n $3 ]]; then
        run iwctl --passphrase "$3" station "$1" connect "$2" || return 1
    else
        run iwctl station "$1" connect "$2" || return 1
    fi
    wait_online 20
}

wifi_menu() {
    local dev lines=() line ssid sec opts=() pw
    dev="$(wifi_dev)" || { bad "No Wi-Fi card found."; pause; return; }
    rfkill unblock wifi 2>/dev/null || true
    iwctl station "${dev}" scan >/dev/null 2>&1 || true
    start_spinner "Searching for Wi-Fi networks..."; sleep 4; stop_spinner
    # iwctl prints a table with colors; strip them and read "name  security  signal".
    mapfile -t lines < <(iwctl station "${dev}" get-networks 2>/dev/null | sed -e 's/\x1b\[[0-9;]*m//g')
    for line in "${lines[@]}"; do
        if [[ ${line} =~ ^[[:space:]\>]*(.*[^[:space:]])[[:space:]]+(psk|open|8021x|wep)[[:space:]]+(\*+)[[:space:]]*$ ]]; then
            ssid=${BASH_REMATCH[1]}; sec=${BASH_REMATCH[2]}
            opts+=("${sec}:${ssid}" "$(printf '%-5s %-7s %s' "${BASH_REMATCH[3]}" "${sec/psk/locked}" "${ssid}")")
        fi
    done
    (( ${#opts[@]} )) || { bad "No Wi-Fi networks found. Move closer to the router and try again."; pause; return; }
    line="$(choose "Pick your Wi-Fi network (signal, security, name):" "${opts[@]}")"
    sec=${line%%:*}; ssid=${line#*:}
    pw=""
    [[ ${sec} == open ]] || pw="$(secret_input "Password for \"${ssid}\":")"
    start_spinner "Connecting to ${ssid}..."
    if wifi_connect "${dev}" "${ssid}" "${pw}"; then
        stop_spinner; WIFI_USED=yes
    else
        stop_spinner; bad "Couldn't connect to \"${ssid}\". Check the password and try again."; pause
    fi
}

show_connection() {   # which network cards are connected, and their addresses
    local dev kind addr ssid
    while read -r dev addr; do
        kind="cable"
        if [[ -e /sys/class/net/${dev}/wireless ]]; then
            kind="Wi-Fi"
            ssid="$( { iwctl station "${dev}" show 2>/dev/null || true; } | sed -e 's/\x1b\[[0-9;]*m//g' \
                    | awk '/Connected network/ {sub(/.*Connected network[[:space:]]+/, ""); sub(/[[:space:]]+$/, ""); print}')"
            [[ -n ${ssid} ]] && kind="Wi-Fi \"${ssid}\""
        fi
        dim "Using ${kind} (${dev}, address ${addr%/*})"
    done < <(ip -4 -o addr show scope global 2>/dev/null | awk '{print $2, $4}')
    return 0
}

step_network() {
    NET_OK=no; WIFI_USED=no
    if [[ ${UNATTENDED} == yes ]]; then
        case "${ANS[NETWORK]:-auto}" in
            skip) return ;;
            auto)
                if ! wait_online 10 && [[ -n ${ANS[WIFI_SSID]:-} ]]; then
                    wifi_connect "$(wifi_dev)" "${ANS[WIFI_SSID]}" "${ANS[WIFI_PASSWORD]:-}" && WIFI_USED=yes || true
                fi
                if online; then NET_OK=yes; fi
                return 0 ;;
            *) die "NETWORK must be auto or skip." ;;
        esac
    fi
    while true; do
        header 1 "Network"
        start_spinner "Checking the internet connection..."
        if wait_online 5; then
            stop_spinner; NET_OK=yes
            good "Connected to the internet."
            show_connection
            pause
            return 0
        fi
        stop_spinner
        say "Not connected to the internet." \
            "The internet is only needed to update the new system at the end. Without it, the installer still works."
        blank
        local opts=()
        wifi_dev >/dev/null && opts+=(wifi "Connect to Wi-Fi")
        opts+=(again "Check again (plug in a cable first)" skip "Skip: install without internet")
        case "$(choose "What now?" "${opts[@]}")" in
            wifi)  wifi_menu ;;
            again) ;;
            skip)  return ;;
        esac
    done
}

# ---------------------------------------------------------------------
# 2. Language and keyboard
# ---------------------------------------------------------------------
step_locale() {
    local items=()
    if [[ ${UNATTENDED} == yes ]]; then
        need LOCALE; need KEYMAP
    else
        if [[ -z ${ANS[LOCALE]:-} ]]; then
            header 2 "Language"
            dim "Sets how dates, numbers and sorting look. Programs show English text" \
                "(translations are left out to save space)."
            blank
            # One entry per language, en_US first.
            mapfile -t items < <({ echo en_US.UTF-8; awk '$2 == "UTF-8" {print $1}' /usr/share/i18n/SUPPORTED; } | awk '!seen[$0]++')
            ANS[LOCALE]="$(search "Language (type to search, e.g. en_GB, de_DE, id_ID):" "Search..." "${items[@]}")"
        fi
        if [[ -z ${ANS[KEYMAP]:-} ]]; then
            header 2 "Keyboard"
            dim "us = US English, uk = British, de = German, fr = French..."
            blank
            mapfile -t items < <({ echo us; localectl list-keymaps --no-pager 2>/dev/null; } | awk '!seen[$0]++')
            ANS[KEYMAP]="$(search "Keyboard layout (type to search):" "Search..." "${items[@]}")"
        fi
    fi
    grep -q "^${ANS[LOCALE]} " /usr/share/i18n/SUPPORTED || die "Unknown language: ${ANS[LOCALE]}"
    # Use the layout right away, so passwords typed below match the new system.
    loadkeys "${ANS[KEYMAP]}" >>"${LOG}" 2>&1 || die "Unknown keyboard layout: ${ANS[KEYMAP]}"
}

# ---------------------------------------------------------------------
# 3. Timezone
# ---------------------------------------------------------------------
step_timezone() {
    local zones=()
    if [[ ${UNATTENDED} == yes ]]; then
        need TIMEZONE
    elif [[ -z ${ANS[TIMEZONE]:-} ]]; then
        header 3 "Timezone"
        dim "Type your city or a nearby one in the same timezone, e.g. Jakarta, Berlin, New_York."
        blank
        mapfile -t zones < <({ echo UTC; timedatectl list-timezones --no-pager; } | awk '!seen[$0]++')
        ANS[TIMEZONE]="$(search "Timezone (type to search):" "Search..." "${zones[@]}")"
    fi
    [[ -f /usr/share/zoneinfo/${ANS[TIMEZONE]} ]] || die "Unknown timezone: ${ANS[TIMEZONE]}"
}

# ---------------------------------------------------------------------
# 4. Computer name
# ---------------------------------------------------------------------
valid_hostname() { [[ $1 =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]]; }

step_hostname() {
    if [[ ${UNATTENDED} == yes ]]; then
        need HOSTNAME
    else
        header 4 "Computer name"
        dim "The name of this computer on the network. Letters, numbers and dashes (-)," \
            "not at the start or end."
        blank
        while [[ -z ${ANS[HOSTNAME]:-} ]] || ! valid_hostname "${ANS[HOSTNAME]}"; do
            ANS[HOSTNAME]="$(text_input "Computer name:" "${ANS[HOSTNAME]:-${DISTRO_ID}}")"
            valid_hostname "${ANS[HOSTNAME]}" || bad "\"${ANS[HOSTNAME]}\" can't be used. Try again."
        done
    fi
    valid_hostname "${ANS[HOSTNAME]}" || die "Invalid computer name: ${ANS[HOSTNAME]}"
}

# ---------------------------------------------------------------------
# 5. User account
# ---------------------------------------------------------------------
valid_username() {
    [[ $1 =~ ^[a-z][a-z0-9_-]{0,30}$ ]] && ! grep -q "^$1:" "${LIVE_ROOT}/etc/passwd"
}

ask_password() {   # ask_password "question" -> prints the password
    local p1 p2
    while true; do
        p1="$(secret_input "$1")"
        p2="$(secret_input "Type it again:")"
        if [[ -z ${p1} ]]; then bad "The password can't be empty."
        elif [[ ${p1} != "${p2}" ]]; then bad "The two passwords don't match. Try again."
        else printf '%s' "${p1}"; return; fi
    done
}

step_user() {
    local suggest
    if [[ ${UNATTENDED} == yes ]]; then
        need USERNAME; need PASSWORD
    else
        header 5 "Your account"
        dim "Your user may use sudo (admin tasks, with your password). The root account stays locked."
        blank
        [[ -n ${ANS[FULLNAME]+set} ]] || ANS[FULLNAME]="$(text_input "Your full name (may be empty):" "" "e.g. Alex Doe")"
        suggest="$(printf '%s' "${ANS[FULLNAME]%% *}" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')"
        while [[ -z ${ANS[USERNAME]:-} ]] || ! valid_username "${ANS[USERNAME]}"; do
            ANS[USERNAME]="$(text_input "Username (to log in; lowercase letters, numbers, - or _):" \
                "${ANS[USERNAME]:-${suggest}}")"
            valid_username "${ANS[USERNAME]}" || bad "\"${ANS[USERNAME]}\" can't be used (wrong characters, or a system name). Try another."
        done
        [[ -n ${ANS[PASSWORD]:-} ]] || ANS[PASSWORD]="$(ask_password "Password for ${ANS[USERNAME]}:")"
    fi
    valid_username "${ANS[USERNAME]}" || die "Invalid username: ${ANS[USERNAME]}"
}

# ---------------------------------------------------------------------
# 6. Disk
# ---------------------------------------------------------------------
live_disk() {   # the USB stick we booted from: never offered
    local src
    src="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
    [[ -n ${src} ]] && lsblk -no PKNAME "${src}" 2>/dev/null | head -n1
}

need_mib() { echo $(( (MIN_ROOT_GB * 1024) + EFI_SIZE_MB + $(ram_mib) )); }

largest_free() {   # prints "START END" (sectors, inclusive) of the largest free area of $1
    sfdisk -F "$1" 2>/dev/null | awk 'f && $3 > 0 {print $1, $2, $3} /^ *Start/ {f=1}' \
        | sort -k3 -n | tail -n1 | awk '{print $1, $2}'
}

free_mib() {   # size of the largest free area of $1, in MiB
    local area ss
    area="$(largest_free "$1")"; [[ -n ${area} ]] || { echo 0; return; }
    ss="$(blockdev --getss "$1")"
    read -r s e <<<"${area}"
    echo $(( (e - s + 1) * ss / 1048576 ))
}

has_windows() {   # is there a Windows boot manager on any EFI partition of $1?
    local p m found=1
    for p in $(lsblk -lnpo NAME,PARTTYPE "$1" | awk 'tolower($2) == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" {print $1}'); do
        m="$(mktemp -d)"
        if mount -o ro "${p}" "${m}" 2>/dev/null; then
            [[ -f ${m}/EFI/Microsoft/Boot/bootmgfw.efi ]] && found=0
            umount "${m}"
        fi
        rmdir "${m}"
    done
    return ${found}
}

step_disk() {
    local live items=() name size model need
    live="$(live_disk || true)"
    need="$(need_mib)"
    if [[ ${UNATTENDED} == yes ]]; then
        need DISK; need MODE
    else
        if [[ -z ${ANS[DISK]:-} ]]; then
            header 6 "Disk"
            while read -r name size model; do
                [[ /dev/${live} == "${name}" ]] && continue
                items+=("${name}" "$(printf '%-14s %5d GB  %s' "${name}" $((size / 1000000000)) "${model:-disk}")")
            done < <(lsblk -dbnpo NAME,SIZE,MODEL,TYPE | awk '$NF == "disk" && $1 !~ /zram|loop/ {NF--; print}')
            (( ${#items[@]} )) || die "No disk found to install on."
            ANS[DISK]="$(choose "Install ${DISTRO_NAME} on which disk?" "${items[@]}")"
        fi
        if [[ -z ${ANS[MODE]:-} ]]; then
            local fm opts=(erase "Erase the whole disk")
            header 6 "Disk"
            say "What's on ${ANS[DISK]} now:"
            lsblk -o NAME,SIZE,FSTYPE,LABEL "${ANS[DISK]}" 2>/dev/null | sed 's/^/    /' >/dev/tty
            blank
            fm="$(free_mib "${ANS[DISK]}")"
            say "Largest free (unused) space: $(gib "${fm}") GB. ${DISTRO_NAME} needs $(gib "${need}") GB."
            if (( fm >= need )); then
                opts+=(free "Use the $(gib "${fm}") GB of free space (keep Windows and other data)")
            else
                dim "To install next to Windows: in Windows, open Disk Management and shrink" \
                    "the Windows partition, then start the installer again."
            fi
            blank
            ANS[MODE]="$(choose "How should ${DISTRO_NAME} use ${ANS[DISK]}?" "${opts[@]}")"
        fi
    fi

    [[ -b ${ANS[DISK]} ]] || die "Not a disk: ${ANS[DISK]}"
    [[ $(lsblk -dno TYPE "${ANS[DISK]}") == disk ]] || die "${ANS[DISK]} is not a whole disk (give e.g. /dev/sda, not /dev/sda1)."
    [[ /dev/${live} != "${ANS[DISK]}" ]] || die "${ANS[DISK]} is the USB stick the installer runs from."
    if lsblk -nro MOUNTPOINTS "${ANS[DISK]}" | grep -q .; then
        die "Something on ${ANS[DISK]} is in use (mounted). Unmount it or restart the installer."
    fi
    case "${ANS[MODE]}" in
        free)
            [[ $(blkid -o value -s PTTYPE "${ANS[DISK]}") == gpt ]] \
                || die "${ANS[DISK]} doesn't use a GPT partition table, so \"free space\" mode can't be used (it would have to convert the disk)." ;;&
        erase)
            (( $(lsblk -dbno SIZE "${ANS[DISK]}") / 1048576 >= need )) \
                || die "${ANS[DISK]} is too small: ${DISTRO_NAME} needs $(gib "${need}") GB (system + swap the size of your RAM)." ;;
        free)
            (( $(free_mib "${ANS[DISK]}") >= need )) \
                || die "Not enough free space on ${ANS[DISK]} (need $(gib "${need}") GB). In Windows, shrink the Windows partition in Disk Management first." ;;
        *) die "MODE must be erase or free." ;;
    esac
    WINDOWS=no
    if has_windows "${ANS[DISK]}"; then WINDOWS=yes; fi
}

# ---------------------------------------------------------------------
# 7. Encryption
# ---------------------------------------------------------------------
step_encrypt() {
    if [[ ${UNATTENDED} == yes ]]; then
        need ENCRYPT
    elif [[ -z ${ANS[ENCRYPT]:-} ]]; then
        case "${ENCRYPTION}" in
            yes|no) ANS[ENCRYPT]=${ENCRYPTION} ;;
            *)
                header 7 "Encryption"
                say "Encryption locks your files with a password, asked every time the computer" \
                    "starts. If the laptop is lost or stolen, nobody can read them."
                warn "If you forget this password, your data can't be recovered."
                blank
                if yesno --defaultno "Encrypt ${DISTRO_NAME}?"; then
                    ANS[ENCRYPT]=yes
                else
                    ANS[ENCRYPT]=no
                fi ;;
        esac
        if [[ ${ANS[ENCRYPT]} == yes && -z ${ANS[LUKS_PASSWORD]:-} ]]; then
            if yesno "Use your account password for the encryption too? (No = set a separate one)"; then
                ANS[LUKS_PASSWORD]=${ANS[PASSWORD]}
            else
                ANS[LUKS_PASSWORD]="$(ask_password "Encryption password (asked at every start):")"
            fi
        fi
    fi
    case "${ANS[ENCRYPT]}" in
        yes) [[ -n ${ANS[LUKS_PASSWORD]:-} ]] || die "ENCRYPT=yes needs LUKS_PASSWORD." ;;
        no)  ;;
        *)   die "ENCRYPT must be yes or no." ;;
    esac
}

# ---------------------------------------------------------------------
# 8. Desktop (optional)
# ---------------------------------------------------------------------
step_desktop() {
    if [[ ${UNATTENDED} == yes ]]; then
        ANS[DESKTOP]=${ANS[DESKTOP]:-no}
    elif [[ -z ${ANS[DESKTOP]:-} ]]; then
        header 8 "Desktop"
        if [[ ${NET_OK} == yes ]]; then
            say "${DISTRO_NAME} can be text only, or come with a desktop: MangoWM (a small" \
                "window manager with scrolling windows), a status bar (Waybar), a launcher" \
                "(Ctrl+Space) and the foot terminal, in a black-and-white look." \
                "The desktop is downloaded now: the install takes a few minutes longer" \
                "and uses roughly 650 MB of disk space. You can also add it later with:" \
                "    sudo monarch-add-desktop"
            blank
            ANS[DESKTOP]="$(choose "How should ${DISTRO_NAME} be installed?" \
                no  "Without desktop: text only (smallest, default)" \
                yes "With desktop: MangoWM + bar + launcher + terminal")"
        else
            say "The desktop (MangoWM) is downloaded from the internet, and you're not" \
                "connected, so it can't be included now. After the restart, connect and run:" \
                "    sudo monarch-add-desktop"
            ANS[DESKTOP]=no
            pause
        fi
    fi
    case "${ANS[DESKTOP]}" in
        yes) [[ ${NET_OK} == yes ]] || die "DESKTOP=yes needs internet (NETWORK=auto with a cable or Wi-Fi)." ;;
        no)  ;;
        *)   die "DESKTOP must be yes or no." ;;
    esac
}

# ---------------------------------------------------------------------
# 9. Summary and confirmation
# ---------------------------------------------------------------------
step_summary() {
    local where net desktop text answer lines=()
    if [[ ${ANS[MODE]} == erase ]]; then
        where="ERASE EVERYTHING on ${ANS[DISK]} ($(lsblk -dno SIZE,MODEL "${ANS[DISK]}" | xargs))"
    else
        where="free space on ${ANS[DISK]} ($(gib "$(free_mib "${ANS[DISK]}")") GB); everything else is kept"
    fi
    desktop="no (text only)"
    [[ ${ANS[DESKTOP]} == yes ]] && desktop="MangoWM (downloaded during the install)"
    net="not connected (no update at the end)"
    [[ ${NET_OK} == yes ]] && net="connected (update packages at the end)"
    text="Network:        ${net}
Language:       ${ANS[LOCALE]}
Keyboard:       ${ANS[KEYMAP]}
Timezone:       ${ANS[TIMEZONE]}
Computer name:  ${ANS[HOSTNAME]}
User:           ${ANS[USERNAME]}${ANS[FULLNAME]:+ (${ANS[FULLNAME]})}, may use sudo; root locked
Install to:     ${where}
Encryption:     ${ANS[ENCRYPT]}
Desktop:        ${desktop}
Hibernation:    swap file of $(gib "$(ram_mib)") GB (size of RAM)
Windows found:  ${WINDOWS}"
    log "Summary:"$'\n'"${text}"
    if [[ ${UNATTENDED} == yes ]]; then
        echo "${text}"
        [[ ${ANS[CONFIRM]:-} == yes ]] || die "Set CONFIRM=yes in the answers file to really install."
        return
    fi
    header 9 "Check your choices"
    mapfile -t lines <<<"${text}"
    box "${DIM}" "${lines[@]}"
    blank
    if [[ ${ANS[MODE]} == erase ]]; then
        warn "Everything on ${ANS[DISK]} will be deleted."
    fi
    say "Nothing has been changed yet. Esc = quit without changes."
    blank
    while true; do
        answer="$(text_input "To install, type yes and press Enter:" "" "yes")"
        [[ ${answer,,} == yes ]] && return
        bad "You typed \"${answer}\", not \"yes\". Nothing was changed."
    done
}

# ---------------------------------------------------------------------
# Install steps. Each runs in a subshell that stops at the first error;
# values it finds (partition names) come back through ${STATE}.
# ---------------------------------------------------------------------
STATE="$(mktemp)"
save() { printf '%s=%q\n' "$1" "$2" >>"${STATE}"; }
STEP_NO=0
STEPS=0     # set by install_system

step() {   # step "title" function
    local title=$1 rc
    shift
    STEP_NO=$((STEP_NO + 1))
    log "== ${title}"
    start_spinner "(${STEP_NO}/${STEPS}) ${title}..."
    run_isolated "$@" >>"${LOG}" 2>&1
    rc=${RUN_RC}
    stop_spinner
    (( rc == 0 )) || die "\"${title}\" failed."
    good "(${STEP_NO}/${STEPS}) ${title}"
    # shellcheck source=/dev/null
    source "${STATE}"
}

do_partition() {
    local disk=${ANS[DISK]} ss s1 e1 s2 e2 area esp root
    if [[ ${ANS[MODE]} == erase ]]; then
        wipefs -af "${disk}"
        sgdisk --zap-all "${disk}"
        sgdisk -n "1:0:+${EFI_SIZE_MB}M" -t "1:${EFI_TYPE}" -c "1:${DISTRO_NAME} EFI" \
               -n "2:0:0" -t "2:${ROOT_TYPE}" -c "2:${DISTRO_NAME}" "${disk}"
        partx -u "${disk}" || true; udevadm settle
        save ESP_PART "$(partdev "${disk}" 1)"
        save ROOT_PART "$(partdev "${disk}" 2)"
        return
    fi
    # Free space: two new partitions inside the largest free area. Our own EFI
    # partition, so Windows' (often only 100 MB) EFI partition is never touched.
    ss="$(blockdev --getss "${disk}")"
    area="$(largest_free "${disk}")"
    read -r s1 e2 <<<"${area}"
    s1=$(( (s1 + 2047) / 2048 * 2048 ))                    # align to 1 MiB
    e1=$(( s1 + EFI_SIZE_MB * 1048576 / ss - 1 ))
    s2=$(( e1 + 1 ))
    e2=$(( (e2 + 1) / 2048 * 2048 - 1 ))
    (( e2 > s2 )) || { echo "Free area too small"; return 1; }
    sgdisk -n "0:${s1}:${e1}" -t "0:${EFI_TYPE}" -c "0:${DISTRO_NAME} EFI" "${disk}"
    sgdisk -n "0:${s2}:${e2}" -t "0:${ROOT_TYPE}" -c "0:${DISTRO_NAME}" "${disk}"
    partx -u "${disk}" || partx -a "${disk}" || true; udevadm settle
    # Find the two new partitions by where they start.
    esp="$(sfdisk -l -o Device,Start "${disk}" | awk -v s="${s1}" '$2 == s {print $1}')"
    root="$(sfdisk -l -o Device,Start "${disk}" | awk -v s="${s2}" '$2 == s {print $1}')"
    [[ -n ${esp} && -n ${root} ]] || { echo "Can't find the new partitions"; return 1; }
    save ESP_PART "${esp}"
    save ROOT_PART "${root}"
}

do_format() {
    local dev=${ROOT_PART}
    for _ in 1 2 3 4 5; do [[ -b ${ESP_PART} && -b ${ROOT_PART} ]] && break; sleep 1; done
    if [[ ${ANS[ENCRYPT]} == yes ]]; then
        # LUKS2 with argon2id (the strong default). Key goes through stdin, never the log.
        printf '%s' "${ANS[LUKS_PASSWORD]}" | cryptsetup luksFormat --type luks2 --batch-mode \
            --label "${DISTRO_ID}-crypt" --key-file=- "${ROOT_PART}"
        printf '%s' "${ANS[LUKS_PASSWORD]}" | cryptsetup open --allow-discards --key-file=- \
            "${ROOT_PART}" "${CRYPT_NAME}"
        dev=/dev/mapper/${CRYPT_NAME}
    fi
    save ROOT_DEV "${dev}"
    mkfs.fat -F 32 -n MONARCH_EFI "${ESP_PART}"
    mkfs.btrfs -f -L "${DISTRO_ID}" "${dev}"
}

do_mount() {
    local opts=${BTRFS_MOUNT_OPTIONS} sv m
    mkdir -p "${TARGET}"
    mount "${ROOT_DEV}" "${TARGET}"
    for sv in ${BTRFS_SUBVOLUMES}; do btrfs subvolume create "${TARGET}/${sv}"; done
    umount "${TARGET}"
    mount -o "${opts},subvol=@" "${ROOT_DEV}" "${TARGET}"
    for m in "home:@home" "var/log:@var_log" "var/cache:@var_cache" "swap:@swap"; do
        mkdir -p "${TARGET}/${m%%:*}"
        mount -o "${opts},subvol=${m##*:}" "${ROOT_DEV}" "${TARGET}/${m%%:*}"
    done
    mkdir -p "${TARGET}/boot"
    mount -o "${ESP_OPTS}" "${ESP_PART}" "${TARGET}/boot"
    # Swap file the size of RAM, for hibernation (btrfs makes it no-copy, uncompressed).
    btrfs filesystem mkswapfile --size "$(ram_mib)m" "${TARGET}/swap/swapfile"
    save RESUME_OFFSET "$(btrfs inspect-internal map-swapfile -r "${TARGET}/swap/swapfile")"
}

do_copy() {
    # Copy the live system image; the -x keeps rsync on this one file system.
    # /boot is skipped: it's the FAT EFI partition (no Linux permissions), and
    # the live image's /boot is empty anyway.
    local kver
    if interactive; then
        # Progress bar: rsync reports a percentage, awk draws [#####.....] 45%.
        rsync -aAXHx --exclude=/boot --info=progress2 --no-inc-recursive "${LIVE_ROOT}/" "${TARGET}/" \
            | stdbuf -oL tr '\r' '\n' \
            | awk -v title="${COPY_TITLE}" '{for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+%$/) {
                  p = $i + 0; bar = ""; for (j = 0; j < 30; j++) bar = bar (j < p * 30 / 100 ? "#" : ".")
                  printf "\r  %s [%s] %3d%%", title, bar, p; fflush() }} END {print ""}' >/dev/tty
    else
        rsync -aAXHx --exclude=/boot "${LIVE_ROOT}/" "${TARGET}/"
    fi
    # The kernel file goes to /boot (the live image keeps it in /usr/lib/modules).
    kver="$(ls "${TARGET}/usr/lib/modules" | head -n1)"
    cp "${TARGET}/usr/lib/modules/${kver}/vmlinuz" "${TARGET}/boot/vmlinuz-${KERNEL}"
    # Wi-Fi networks you connected to in the installer work after the restart too.
    if compgen -G "/var/lib/iwd/*" >/dev/null; then
        mkdir -p "${TARGET}/var/lib/iwd"
        cp -a /var/lib/iwd/. "${TARGET}/var/lib/iwd/"
    fi
}

do_cleanup_live() {
    # Remove what only makes sense on the live ISO.
    local t=${TARGET}
    rm -f  "${t}/etc/systemd/system/getty@tty1.service.d/autologin.conf" \
           "${t}/etc/mkinitcpio.conf.d/archiso.conf" \
           "${t}/etc/systemd/journald.conf.d/volatile-storage.conf" \
           "${t}/etc/systemd/logind.conf.d/do-not-suspend.conf" \
           "${t}/etc/systemd/system-generators/systemd-gpt-auto-generator" \
           "${t}/etc/systemd/system/pacman-init.service" \
           "${t}/etc/systemd/system/etc-pacman.d-gnupg.mount" \
           "${t}/etc/systemd/system/multi-user.target.wants/pacman-init.service" \
           "${t}/usr/local/bin/monarch-install" \
           "${t}/etc/machine-id"
    rmdir "${t}/etc/systemd/system/getty@tty1.service.d" 2>/dev/null || true
    printf '\n  %s %s (built for ThinkPad L14 Gen 5)\n  Other hardware not working? Read: less /usr/share/monarch/HARDWARE.md\n\n' \
        "${DISTRO_NAME}" "${DISTRO_VERSION}" >"${t}/etc/motd"
    arch-chroot "${t}" pacman -R --noconfirm mkinitcpio-archiso
}

do_settings() {
    local t=${TARGET} l
    # Language
    for l in "${ANS[LOCALE]}" en_US.UTF-8; do
        sed -i "s/^#\(${l//./\\.} \)/\1/" "${t}/etc/locale.gen"
    done
    echo "LANG=${ANS[LOCALE]}" >"${t}/etc/locale.conf"
    arch-chroot "${t}" locale-gen
    # Keyboard (also used when typing the encryption password at start)
    printf 'KEYMAP=%s\n' "${ANS[KEYMAP]}" >"${t}/etc/vconsole.conf"
    # Timezone and clock
    ln -sf "/usr/share/zoneinfo/${ANS[TIMEZONE]}" "${t}/etc/localtime"
    arch-chroot "${t}" hwclock --systohc || true
    # Computer name
    echo "${ANS[HOSTNAME]}" >"${t}/etc/hostname"
    printf '127.0.0.1 localhost\n::1       localhost\n127.0.1.1 %s\n' "${ANS[HOSTNAME]}" >"${t}/etc/hosts"
    # A new unique machine ID
    arch-chroot "${t}" systemd-machine-id-setup
    # pacman: keyring, and the size-trimming rules (NoExtract) for future installs
    arch-chroot "${t}" pacman-key --init
    arch-chroot "${t}" pacman-key --populate archlinux
    if ! grep -q 'monarch size trimming' "${t}/etc/pacman.conf"; then
        awk -v rules="$(printf '# monarch size trimming (from /etc/pacman.d/monarch-noextract.conf)\n'; grep '^NoExtract' "${t}/etc/pacman.d/monarch-noextract.conf")" \
            '{print} /^\[options\]/ && !done {print rules; done=1}' \
            "${t}/etc/pacman.conf" >"${t}/etc/pacman.conf.new"
        mv "${t}/etc/pacman.conf.new" "${t}/etc/pacman.conf"
    fi
    # Services: network, Wi-Fi, time sync, power saving, SSD trim
    arch-chroot "${t}" systemctl enable systemd-networkd systemd-resolved iwd \
        systemd-timesyncd power-profiles-daemon monarch-power-source thermald bluetooth fstrim.timer
}

do_users() {
    local t=${TARGET}
    arch-chroot "${t}" useradd -m -G "${USER_GROUPS// /,}" -s /bin/bash \
        -c "${ANS[FULLNAME]:-}" "${ANS[USERNAME]}"
    printf '%s:%s\n' "${ANS[USERNAME]}" "${ANS[PASSWORD]}" | arch-chroot "${t}" chpasswd
    # Members of "wheel" may use sudo (with their own password).
    printf '%%wheel ALL=(ALL:ALL) ALL\n' >"${t}/etc/sudoers.d/10-wheel"
    chmod 440 "${t}/etc/sudoers.d/10-wheel"
    # Root can't log in (it had no password on the live ISO).
    arch-chroot "${t}" usermod -p '!*' root
}

do_fstab() {
    local t=${TARGET} uuid esp opts=${BTRFS_MOUNT_OPTIONS}
    uuid="$(blkid -s UUID -o value "${ROOT_DEV}")"
    esp="$(blkid -s UUID -o value "${ESP_PART}")"
    cat >"${t}/etc/fstab" <<EOF
# /etc/fstab: file systems mounted at start (written by monarch-install)
# <device>      <where>     <type>  <options>                              <dump> <check>
UUID=${uuid}  /           btrfs   ${opts},subvol=@          0 0
UUID=${uuid}  /home       btrfs   ${opts},subvol=@home      0 0
UUID=${uuid}  /var/log    btrfs   ${opts},subvol=@var_log   0 0
UUID=${uuid}  /var/cache  btrfs   ${opts},subvol=@var_cache 0 0
UUID=${uuid}  /swap       btrfs   ${opts},subvol=@swap      0 0
UUID=${esp}   /boot       vfat    ${ESP_OPTS}  0 2
/swap/swapfile  none      swap    defaults                  0 0
EOF
    if [[ ${ANS[ENCRYPT]} == yes ]]; then
        save LUKS_UUID "$(blkid -s UUID -o value "${ROOT_PART}")"
    else
        save LUKS_UUID ""
    fi
    save FS_UUID "${uuid}"
}

do_update() {
    # Only with internet. Shown on screen (pacman's own progress) and kept in the log.
    # A failed update is not fatal: the system works without it.
    if interactive; then
        script -qefc "arch-chroot ${TARGET} pacman -Syu --noconfirm" -a "${LOG}" \
            || bad "Update failed; run 'sudo pacman -Syu' after the restart."
    else
        arch-chroot "${TARGET}" pacman -Syu --noconfirm >>"${LOG}" 2>&1 \
            || echo "WARNING: update failed; run 'sudo pacman -Syu' after the restart."
    fi
}

do_desktop() {
    # Needs internet. A failed download is not fatal: the text system works.
    local cmd="arch-chroot ${TARGET} /usr/local/sbin/monarch-add-desktop ${ANS[USERNAME]}"
    if interactive; then
        script -qefc "${cmd}" -a "${LOG}" \
            || bad "Desktop install failed; after the restart run: sudo monarch-add-desktop"
    else
        ${cmd} >>"${LOG}" 2>&1 \
            || echo "WARNING: desktop install failed; run 'sudo monarch-add-desktop' after the restart."
    fi
}

do_initramfs() {
    local t=${TARGET} hooks=() h
    # The start-up system. Only hooks that exist in this mkinitcpio version are used.
    for h in base systemd autodetect microcode modconf kms keyboard sd-vconsole block \
             $([[ ${ANS[ENCRYPT]} == yes ]] && echo sd-encrypt) filesystems fsck; do
        [[ -f ${t}/usr/lib/initcpio/install/${h} ]] && hooks+=("${h}")
    done
    mkdir -p "${t}/etc/mkinitcpio.conf.d" "${t}/etc/mkinitcpio.d"
    printf '# Written by monarch-install\nHOOKS=(%s)\nCOMPRESSION="zstd"\n' "${hooks[*]}" \
        >"${t}/etc/mkinitcpio.conf.d/monarch.conf"
    cat >"${t}/etc/mkinitcpio.d/${KERNEL}.preset" <<EOF
# mkinitcpio preset for ${KERNEL} (written by monarch-install): one image, no fallback
ALL_kver="/boot/vmlinuz-${KERNEL}"
PRESETS=('default')
default_image="/boot/initramfs-${KERNEL}.img"
EOF
    arch-chroot "${t}" mkinitcpio -P
}

set_grub() {   # set_grub KEY "value" in /etc/default/grub (replace or add)
    local f=${TARGET}/etc/default/grub
    if grep -qE "^#?$1=" "${f}"; then
        sed -i -E "s|^#?$1=.*|$1=\"$2\"|" "${f}"
    else
        printf '%s="%s"\n' "$1" "$2" >>"${f}"
    fi
}

do_bootloader() {
    local t=${TARGET} cmdline=""
    [[ -n ${LUKS_UUID} ]] && cmdline="rd.luks.name=${LUKS_UUID}=${CRYPT_NAME} rd.luks.options=discard "
    cmdline+="resume=UUID=${FS_UUID} resume_offset=${RESUME_OFFSET}"
    set_grub GRUB_DISTRIBUTOR "${DISTRO_NAME}"
    set_grub GRUB_CMDLINE_LINUX "${cmdline}"
    set_grub GRUB_CMDLINE_LINUX_DEFAULT "${KERNEL_CMDLINE_EXTRA}"
    set_grub GRUB_DISABLE_SUBMENU "y"
    if [[ ${WINDOWS} == yes || ${ANS[MODE]} == free ]]; then
        set_grub GRUB_TIMEOUT "5"
        set_grub GRUB_TIMEOUT_STYLE "menu"
        set_grub GRUB_DISABLE_OS_PROBER "false"    # add Windows to the menu
    else
        set_grub GRUB_TIMEOUT "2"
    fi
    arch-chroot "${t}" grub-install --target=x86_64-efi --efi-directory=/boot \
        --boot-directory=/boot --bootloader-id="${DISTRO_NAME}"
    # Also as the default boot file of our EFI partition, for PCs that forget
    # boot entries. Only ever on OUR EFI partition, never Windows'.
    arch-chroot "${t}" grub-install --target=x86_64-efi --efi-directory=/boot \
        --boot-directory=/boot --removable
    arch-chroot "${t}" grub-mkconfig -o /boot/grub/grub.cfg
}

finish_report() {
    local used
    used="$(btrfs filesystem usage -b "${TARGET}" 2>/dev/null | awk -F: '/^ *Used:/ {gsub(/ /, "", $2); print int($2 / 1048576); exit}')"
    {
        echo "${DISTRO_NAME} installed $(date -u '+%Y-%m-%d %H:%M UTC')"
        echo "Disk space used (compressed, incl. $(gib "$(ram_mib)") GB swap file): ${used} MiB"
        echo "System without swap file: $(( used - $(ram_mib) )) MiB"
        echo "Boot partition used: $(df -m --output=used "${TARGET}/boot" | tail -n1 | xargs) MiB"
        echo "Packages: $(arch-chroot "${TARGET}" pacman -Qq | wc -l)"
    } | tee "${TARGET}/var/log/monarch-install-size.txt" /tmp/monarch-install-size.txt >>"${LOG}"
    cp "${LOG}" "${TARGET}/var/log/monarch-install.log"
    chmod 600 "${TARGET}/var/log/monarch-install.log"
}

cleanup() {   # unmount everything; each part may already be undone, that's fine
    safety_net_off
    stop_spinner
    ui_restore
    swapoff "${TARGET}/swap/swapfile" 2>/dev/null || true
    umount -R "${TARGET}" 2>/dev/null || true
    cryptsetup close "${CRYPT_NAME}" 2>/dev/null || true
    rm -f "${STATE}"
    return 0
}

install_system() {
    trap cleanup EXIT
    # From here on, Ctrl+C stops the installation (and unmounts everything).
    trap 'die "Stopped with Ctrl+C. The disk is only partly installed: run the installer again."' INT
    if interactive; then header 9 "Installing"; fi
    STEPS=10
    [[ ${NET_OK} == yes ]] && STEPS=11
    [[ ${ANS[DESKTOP]} == yes ]] && STEPS=$((STEPS + 1))
    step "Making partitions on ${ANS[DISK]}" do_partition
    step "Formatting$([[ ${ANS[ENCRYPT]} == yes ]] && echo " and encrypting")" do_format
    step "Creating Btrfs subvolumes and the swap file" do_mount
    log "== Copying the system"
    STEP_NO=$((STEP_NO + 1))
    COPY_TITLE="(${STEP_NO}/${STEPS}) Copying the system"
    interactive || echo "... ${COPY_TITLE}"
    run_isolated do_copy 2>>"${LOG}"
    (( RUN_RC == 0 )) || die "Copying the system failed."
    good "${COPY_TITLE}"
    step "Removing live-only settings" do_cleanup_live
    step "Language, time, name, services" do_settings
    step "Creating your user" do_users
    step "Writing the list of file systems" do_fstab
    if [[ ${NET_OK} == yes && ${ANS[UPDATE]:-yes} == yes ]]; then
        # Not a spinner step: pacman shows its own download progress here.
        STEP_NO=$((STEP_NO + 1))
        log "== Updating packages"
        say "(${STEP_NO}/${STEPS}) Updating packages (shows pacman's download progress):"
        do_update
        good "(${STEP_NO}/${STEPS}) Updating packages"
    fi
    if [[ ${ANS[DESKTOP]} == yes ]]; then
        STEP_NO=$((STEP_NO + 1))
        log "== Installing the desktop"
        say "(${STEP_NO}/${STEPS}) Installing the desktop (shows pacman's download progress):"
        do_desktop
        good "(${STEP_NO}/${STEPS}) Installing the desktop"
    fi
    step "Building the start-up system (initramfs)" do_initramfs
    step "Installing the boot loader (GRUB)" do_bootloader
    finish_report
    sync
    cleanup
    safety_net_on
    trap 'ui_restore' EXIT
}

# ---------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------
main() {
    while (( $# )); do
        case "$1" in
            --config)  [[ -n ${2:-} ]] || { echo "--config needs a file"; exit 1; }
                       UNATTENDED=yes; CONFIG_FILE=$2; shift ;;
            --dry-run) DRY_RUN=yes ;;
            -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
            *) echo "Unknown option: $1 (see monarch-install --help)"; exit 1 ;;
        esac
        shift
    done
    preflight
    [[ ${UNATTENDED} == yes ]] && load_answers "${CONFIG_FILE}"
    export TERM=${TERM:-linux}
    [[ ${UNATTENDED} == no && -t 0 && -t 1 ]] && INTERACTIVE=yes
    safety_net_on
    trap 'UI_INT=1' INT                   # Ctrl+C on a question: "Quit?"
    trap 'ui_restore; exit 1' TERM        # "Yes, quit" from inside a question
    trap 'ui_restore' EXIT

    if interactive; then
        tty_out "${E}[H${E}[2J"$'\n'
        box "${ACC}" "${TITLE}"
        blank
        say "This installs ${DISTRO_NAME} ${DISTRO_VERSION} on this computer." \
            "You'll answer ${STEP_TOTAL} short questions. Nothing is changed on your disks until you type \"yes\" on the summary at the end." \
            "Keys: arrows to move, Enter to pick, type to search long lists, Esc to quit."
        pause
    fi
    step_network
    step_locale
    step_timezone
    step_hostname
    step_user
    step_disk
    step_encrypt
    step_desktop
    step_summary

    if [[ ${DRY_RUN} == yes ]]; then
        blank
        good "Dry run finished: nothing was changed."
        exit 0
    fi

    install_system

    if [[ ${UNATTENDED} == yes ]]; then
        cat /tmp/monarch-install-size.txt
        echo "Installation finished."
        [[ ${ANS[REBOOT]:-no} == yes ]] && systemctl reboot
        exit 0
    fi
    blank
    box "${OK}" "${DISTRO_NAME} is installed."
    blank
    mapfile -t lines </tmp/monarch-install-size.txt
    dim "${lines[@]}" "(Saved in /var/log/monarch-install-size.txt)"
    blank
    say "Remove the USB stick, then restart. Log in as ${ANS[USERNAME]}." "Useful first commands:"
    tty_out "    sudo pacman -Syu      update"$'\n'"    iwctl                 Wi-Fi"$'\n'
    tty_out "    alsamixer             volume"$'\n'"    systemctl hibernate   hibernate"$'\n\n'
    if yesno "Restart now?"; then
        systemctl reboot
    fi
    echo "${DISTRO_NAME} is installed. Type 'reboot' to restart."
}

# Run only when started as a program (tests can "source" this file).
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
