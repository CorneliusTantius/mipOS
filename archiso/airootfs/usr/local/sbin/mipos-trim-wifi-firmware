#!/usr/bin/env bash
# mipos-trim-wifi-firmware: delete Intel Wi-Fi firmware files no kernel here can use.
#
# linux-firmware-intel ships every version of every Intel Wi-Fi chip's
# firmware (~100 MB). The Wi-Fi driver only loads versions up to the newest
# it knows. For each chip this keeps the two newest versions the installed
# kernel(s) can load (the newest, plus one spare) and deletes the rest.
# Runs automatically after kernel/firmware installs and updates (pacman hook
# 90-mipos-trim-wifi-firmware.hook). Safe to run by hand any time.
# MIPOS_ROOT=/some/folder runs it on another system folder (for tests).
set -euo pipefail

root=${MIPOS_ROOT:-}
fw="${root}/usr/lib/firmware"
dir="${fw}/intel/iwlwifi"
[[ -d ${dir} ]] || exit 0

# The firmware names the Wi-Fi driver modules ask for (newest version per kind).
names="$(find "${root}"/usr/lib/modules/*/kernel/drivers/net/wireless/intel/iwlwifi \
             -name '*.ko*' -exec modinfo -F firmware {} \; 2>/dev/null || true)"
max_num="$(grep -oE -- '-[0-9]+\.ucode$' <<<"${names}" | tr -dc '0-9\n' | sort -n | tail -n1 || true)"
max_core="$(grep -oE -- '-c[0-9]+\.ucode$' <<<"${names}" | tr -dc '0-9\n' | sort -n | tail -n1 || true)"
if [[ -z ${max_num} ]]; then
    echo "mipos-trim-wifi-firmware: Wi-Fi driver not found, nothing removed."
    exit 0
fi

# Group files by chip and numbering kind ("-89" or "-c106"), newest first.
declare -A groups=()
for f in "${dir}"/iwlwifi-*.ucode*; do
    base=${f##*/}
    if [[ ${base} =~ ^(iwlwifi-.+)-(c?)([0-9]+)\.ucode(\.[a-z]+)?$ ]]; then
        key="${BASH_REMATCH[1]}|${BASH_REMATCH[2]}"
        groups[${key}]+="${BASH_REMATCH[3]} ${base}"$'\n'
    fi
done

removed=0; freed=0
for key in "${!groups[@]}"; do
    kind=${key##*|}
    max=${max_num}; [[ ${kind} == c ]] && max=${max_core}
    [[ -n ${max} ]] || continue                       # unknown kind: keep all
    kept=0
    while read -r ver base; do
        [[ -n ${base} ]] || continue
        if (( ver <= max && kept < 2 )); then
            kept=$((kept + 1))
        else
            freed=$(( freed + $(stat -c %s "${dir}/${base}") ))
            rm -f "${dir}/${base}"
            removed=$((removed + 1))
        fi
    done < <(printf '%s' "${groups[${key}]}" | sort -rn)
done
# Links in /usr/lib/firmware that pointed to removed files.
find "${fw}" -maxdepth 1 -xtype l -name 'iwlwifi-*' -delete 2>/dev/null || true

echo "mipos-trim-wifi-firmware: removed ${removed} unused Wi-Fi firmware files ($(( freed / 1048576 )) MiB); driver supports up to -${max_num} / -c${max_core:-none}."
