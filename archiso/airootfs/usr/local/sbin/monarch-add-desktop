#!/usr/bin/env bash
# =====================================================================
#  monarch-add-desktop: add the MangoWM desktop (needs internet)
#
#  Usage (as root):   monarch-add-desktop [USERNAME]
#
#  It installs the packages in DESKTOP_PACKAGES (monarch.conf; from the copy on
#  the ISO if there is one, else downloaded), gives the user
#  the monarch settings for MangoWM, Waybar, the Ctrl+Space launcher (fuzzel)
#  and the foot terminal (~/.config/..., only files the user doesn't have
#  yet), and starts the desktop when that user logs in on tty1. tty2 to tty6 stay plain text. Quitting MangoWM returns to the
#  text shell. Run it again any time: it changes nothing twice.
#  The installer runs this for you when you answer yes to the desktop question.
# =====================================================================
set -Eeuo pipefail

CONF=${MONARCH_CONF:-/usr/share/monarch/monarch.conf}
# shellcheck source=/dev/null
source "${CONF}"

[[ ${EUID} -eq 0 ]] || { echo "Run as root: sudo monarch-add-desktop"; exit 1; }

user=${1:-${SUDO_USER:-}}
if [[ -z ${user} ]]; then   # first normal user (the one the installer made)
    user="$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}' /etc/passwd)"
fi
[[ -n ${user} ]] || { echo "No user found. Usage: monarch-add-desktop USERNAME"; exit 1; }
id "${user}" >/dev/null 2>&1 || { echo "No such user: ${user}"; exit 1; }
home="$(getent passwd "${user}" | cut -d: -f6)"
group="$(id -gn "${user}")"

# The ISO carries the desktop's packages (an offline repository); the installer
# makes it available as MONARCH_REPO. On an installed system there is none,
# and the packages are downloaded instead.
repo=${MONARCH_REPO:-/usr/share/${DISTRO_ID}/repo}
installed=no
if [[ -f ${repo}/${DISTRO_ID}-local.db ]]; then
    conf="$(mktemp)"
    {
        echo '[options]'
        echo 'Architecture = x86_64'
        echo 'SigLevel = Required DatabaseOptional'
        grep '^NoExtract' /etc/pacman.conf || true   # keep the size trimming rules
        echo "[${DISTRO_ID}-local]"
        echo "Server = file://${repo}"
    } >"${conf}"
    echo "== Installing from the copy on the USB stick: ${DESKTOP_PACKAGES}"
    # shellcheck disable=SC2086   # the list is meant to split into words
    if pacman --config "${conf}" -Sy --noconfirm >/dev/null \
        && pacman --config "${conf}" -S --needed --noconfirm ${DESKTOP_PACKAGES}; then
        installed=yes
    else
        echo "The copy on the USB stick didn't work; downloading instead."
    fi
    rm -f "${conf}" "/var/lib/pacman/sync/${DISTRO_ID}-local.db"*
fi
if [[ ${installed} != yes ]]; then
    echo "== Downloading and installing: ${DESKTOP_PACKAGES}"
    # -Syu: upgrade everything in the same step (installing new packages next to
    # an outdated system can break programs).
    # shellcheck disable=SC2086
    pacman -Syu --needed --noconfirm ${DESKTOP_PACKAGES}
fi

echo "== Brightness keys need the video group"
usermod -aG video "${user}"

echo "== monarch look and settings for ${user}"
# Copies each program's settings (Nothing-style look) from /usr/share/monarch/desktop
# to ~/.config, but never over a file you already have.
share=/usr/share/monarch/desktop
for f in mango/config.conf waybar/config.jsonc waybar/style.css fuzzel/fuzzel.ini foot/foot.ini mako/config; do
    dest="${home}/.config/${f}"
    if [[ ! -e ${dest} ]]; then
        install -d -o "${user}" -g "${group}" -m 755 "${home}/.config" "$(dirname "${dest}")"
        install -o "${user}" -g "${group}" -m 644 "${share}/${f}" "${dest}"
    fi
done

echo "== Start on tty1 login"
profile="${home}/.bash_profile"
if ! grep -qs '# monarch desktop' "${profile}"; then
    cat >>"${profile}" <<'EOF'

# monarch desktop: start MangoWM when logging in on tty1 (tty2-6 stay text).
# Quit MangoWM to come back to this shell. Delete these lines to turn it off.
if [[ -z ${WAYLAND_DISPLAY:-} && ${XDG_VTNR:-} == 1 ]]; then
    mango
fi
EOF
    chown "${user}:${group}" "${profile}"
fi

echo "Done. Log out and log in again on tty1 (or type: mango). Ctrl+Space opens the launcher, Alt+Enter a terminal."
