# Packages on the live ISO, one per line. Lines starting with # are notes
# (keep notes on their own line). @KERNEL@ is replaced with KERNEL from
# monarch.conf by scripts/10-make-profile.sh.

# --- The smallest system that boots -------------------------------
# Arch's minimal set: systemd, bash, coreutils, pacman...
base
# The Linux kernel
@KERNEL@
# Builds the initramfs (the small start-up system loaded with the kernel)
mkinitcpio
# Lets the initramfs find and start the live system on the ISO
mkinitcpio-archiso

# --- Hardware, Wi-Fi, battery and memory --------------------------
# Firmware (small programs loaded into chips) for Intel graphics, Wi-Fi, Bluetooth
linux-firmware-intel
# Wi-Fi: iwd connects ("iwctl"), wireless-regdb holds each country's radio rules
iwd
wireless-regdb
# zram: compressed swap in RAM
zram-generator
# Bluetooth programs: the bluetooth service and bluetoothctl (pair, connect)
bluez
bluez-utils
# Sound: firmware for Intel sound chips (SOF), their settings (UCM), and
# alsamixer/speaker-test to set the volume and test speakers
sof-firmware
alsa-ucm-conf
alsa-utils
# Power modes (power-saver / balanced / performance) and Intel CPU
# temperature control. monarch adds its own rules for the rest (see
# /etc/udev/rules.d/50-monarch-power.rules).
power-profiles-daemon
thermald

# --- What monarch-install needs, and what the installed system keeps --
# (The installer copies the live system to the disk, so everything the
#  installed system needs must be on the ISO.)
# Copying the system, partitions, file systems, encryption
rsync
gptfdisk
dosfstools
btrfs-progs
cryptsetup
arch-install-scripts
# Boot loader (UEFI) and finding Windows for the boot menu
grub
efibootmgr
os-prober
# Intel CPU fixes, loaded at start
intel-ucode
# Admin rights for your user, a text editor, a pager
sudo
nano
less
