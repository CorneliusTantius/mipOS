#!/usr/bin/env bash
# =====================================================================
#  mipos-install: the mipOS text installer (runs on the live disk)
#
#  Usage:
#    sudo mipos-install                     ask everything with menus
#    sudo mipos-install --config FILE       unattended: read answers from FILE
#                                           (see /usr/share/mipos/answers.example)
#
#  Steps: network, language and keyboard, timezone, computer name, user,
#  disk, encryption, summary, install. Nothing on the disk changes until you
#  confirm on the summary screen.
# =====================================================================
set -Eeuo pipefail

CONF=/usr/share/mipos/mipos.conf
# shellcheck source=/dev/null
. "$CONF"

export LOG=/var/log/mipos-install.log
TARGET=/mnt/mipos
MIN_DISK_GB=20
ESP_TYPE="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
CRYPT_NAME="mipos_root"
UNATTENDED=no

# ---------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------
header() {
    clear
    gum style --border rounded --border-foreground 244 --padding "0 2" --margin "1 0" \
        --bold "$DISTRO_NAME $DISTRO_VERSION installer" "$1"
}
say()   { gum style --foreground 250 "$@"; }
good()  { gum style --foreground 114 "✓ $*"; }
bad()   { gum style --foreground 203 "✗ $*"; }
die()   { echo; bad "$*"; echo "Full log: $LOG"; exit 1; }
log()   { echo "[$(date +%T)] $*" >>"$LOG"; }
run()   { log "+ $*"; "$@" >>"$LOG" 2>&1; }

# Install steps run in a subshell, so any failing command stops that step.
# Values they find (like partition names) are passed back through $STATE.
STATE=$(mktemp)
save() { printf '%s=%q\n' "$1" "$2" >> "$STATE"; }
SPIN_PID=""

# Note: "set -e" is silently ignored in a subshell used with || or &&,
# so the subshell runs with errexit switched off around it instead.
run_step() {
    set +e
    ( set -Eeuo pipefail; "$@" ) >>"$LOG" 2>&1
    STEP_RC=$?
    set -e
}

# Run one install step, with a spinner (or plain text in unattended mode).
step() {
    local title=$1 rc=0 flag; shift
    log "== $title"
    if [ "$UNATTENDED" = yes ] || [ ! -t 1 ]; then
        echo "... $title"
        run_step "$@"; rc=$STEP_RC
    else
        flag=$(mktemp)
        gum spin --spinner dot --title "$title" -- sh -c "while [ -e '$flag' ]; do sleep 0.2; done" &
        SPIN_PID=$!
        run_step "$@"; rc=$STEP_RC
        rm -f "$flag"; wait "$SPIN_PID" 2>/dev/null || true; SPIN_PID=""
    fi
    [ "$rc" -eq 0 ] || die "$title failed."
    # shellcheck source=/dev/null
    . "$STATE"
    [ "$UNATTENDED" = yes ] || good "$title"
}

# Partition number N of a disk: /dev/sda + 2 = /dev/sda2, /dev/nvme0n1 + 2 = /dev/nvme0n1p2
partdev() { case "$1" in *[0-9]) echo "${1}p$2" ;; *) echo "${1}$2" ;; esac; }

ask_password() {   # $1 = label; prints the password
    local p1 p2
    while true; do
        p1=$(gum input --password --placeholder "$1")
        p2=$(gum input --password --placeholder "Type it again")
        if [ -z "$p1" ]; then bad "The password can't be empty." >&2
        elif [ "$p1" != "$p2" ]; then bad "The two passwords don't match. Try again." >&2
        else printf '%s' "$p1"; return; fi
    done
}

cleanup() {
    set +e
    [ -n "$SPIN_PID" ] && kill "$SPIN_PID" 2>/dev/null
    swapoff "$TARGET/swap/swapfile" 2>/dev/null
    umount -R "$TARGET" 2>/dev/null
    cryptsetup close "$CRYPT_NAME" 2>/dev/null
}
trap 'cleanup' EXIT

# ---------------------------------------------------------------------
# Checks before starting
# ---------------------------------------------------------------------
preflight() {
    [ "$(id -u)" -eq 0 ] || { echo "Run with sudo: sudo mipos-install"; exit 1; }
    [ -d /sys/firmware/efi ] || { echo "This PC started in old BIOS mode. $DISTRO_NAME needs UEFI."; exit 1; }
    for c in gum sgdisk sfdisk mkfs.btrfs mkfs.fat cryptsetup rsync arch-chroot blkid lsblk; do
        command -v "$c" >/dev/null || { echo "Missing tool: $c"; exit 1; }
    done
    : > "$LOG"
}

# ---------------------------------------------------------------------
# 1. Network
# ---------------------------------------------------------------------
online() { [ "$(nmcli -t -f CONNECTIVITY general 2>/dev/null)" = "full" ]; }

step_network() {
    [ -n "${NET_SKIP:-}" ] && return
    header "Step 1 of 8: Network"
    while true; do
        if online; then
            local how
            how=$(nmcli -t -f TYPE,STATE device | awk -F: '$2=="connected"{print $1; exit}')
            good "Connected to the internet (${how:-network})."
            sleep 1; return
        fi
        say "Not connected. The internet is needed for updates and apps," \
            "but you can also install offline."
        case $(gum choose "Connect to Wi-Fi" "Check again (cable)" "Skip: install offline") in
            "Connect to Wi-Fi") connect_wifi ;;
            "Check again (cable)") gum spin --title "Waiting for the network..." -- sleep 4 ;;
            *) NET_SKIP=yes; return ;;
        esac
    done
}

connect_wifi() {
    nmcli radio wifi on >/dev/null 2>&1 || true
    local list choice ssid sec pw
    list=$(gum spin --title "Searching for Wi-Fi networks..." -- \
        nmcli -t --escape no -f SIGNAL,SECURITY,SSID device wifi list --rescan yes) || true
    # SSID is the last field, so colons in network names are kept intact.
    list=$(printf '%s\n' "$list" | awk -F: '{ssid=$0; sub(/^[^:]*:[^:]*:/,"",ssid);
            if (ssid!="" && !seen[ssid]++) printf "%3s%%  %-8s %s\n", $1, ($2==""?"open":"locked"), ssid}' \
            | sort -rn)
    if [ -z "$list" ]; then bad "No Wi-Fi networks found."; sleep 2; return; fi
    choice=$(printf '%s\n' "$list" | gum choose --header "Pick your Wi-Fi network:") || return
    ssid=$(printf '%s' "$choice" | sed -E 's/^ *[0-9]+%  [a-z]+ +//')
    sec=$(printf '%s' "$choice" | awk '{print $2}')
    if [ "$sec" = "locked" ]; then
        pw=$(gum input --password --placeholder "Password for \"$ssid\"") || return
        gum spin --title "Connecting to $ssid..." -- \
            nmcli device wifi connect "$ssid" password "$pw" >>"$LOG" 2>&1 \
            || { bad "Couldn't connect. Check the password and try again."; sleep 2; }
    else
        gum spin --title "Connecting to $ssid..." -- nmcli device wifi connect "$ssid" >>"$LOG" 2>&1 \
            || { bad "Couldn't connect."; sleep 2; }
    fi
}

# ---------------------------------------------------------------------
# 2. Language and keyboard
# ---------------------------------------------------------------------
step_locale() {
    if [ -z "${LOCALE_:-}" ]; then
        header "Step 2 of 8: Language"
        say "Type to search, Enter to pick."
        LOCALE_=$( { echo "$LOCALE"; grep -o '^[^ ]*\.UTF-8' /usr/share/i18n/SUPPORTED | grep -vx "$LOCALE"; } \
            | gum filter --placeholder "Language (e.g. en_GB, de_DE)" --height 12)
    fi
    if [ -z "${KEYMAP:-}" ]; then
        header "Step 2 of 8: Keyboard layout"
        KEYMAP=$( { echo "$KEYBOARD_LAYOUT"; awk '/^! layout/{f=1;next} /^!/{f=0} f{print $1}' \
                    /usr/share/X11/xkb/rules/base.lst | grep -vx "$KEYBOARD_LAYOUT"; } \
            | gum filter --placeholder "Keyboard layout (e.g. us, gb, de, fr)" --height 12)
        if [ "$KEYMAP" != "us" ]; then
            say "Note: inside this live desktop the keyboard still types US-style." \
                "Your layout ($KEYMAP) applies after install. Keep that in mind for passwords" \
                "with special characters, or set the layout in System Settings first."
            gum confirm "Continue?" || exit 1
        fi
    fi
}

# ---------------------------------------------------------------------
# 3. Timezone
# ---------------------------------------------------------------------
step_timezone() {
    [ -n "${TZ_:-}" ] && return
    header "Step 3 of 8: Timezone"
    say "Type your city or region, e.g. \"Jakarta\", \"Berlin\", \"New_York\"."
    TZ_=$(timedatectl list-timezones | gum filter --placeholder "Timezone" --height 12)
}

# ---------------------------------------------------------------------
# 4. Computer name
# ---------------------------------------------------------------------
step_hostname() {
    [ -n "${HOSTNAME_:-}" ] && return
    header "Step 4 of 8: Computer name"
    say "The name of this computer on the network. Letters, numbers and dashes."
    while true; do
        HOSTNAME_=$(gum input --value "$DISTRO_ID" --placeholder "Computer name")
        [[ "$HOSTNAME_" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] && return
        bad "Use only letters, numbers and dashes (not at the start or end)."
    done
}

# ---------------------------------------------------------------------
# 5. User
# ---------------------------------------------------------------------
step_user() {
    if [ -z "${USERNAME_:-}" ]; then
        header "Step 5 of 8: Your account"
        FULLNAME=$(gum input --placeholder "Your full name (e.g. Alex Doe)")
        local suggest
        suggest=$(printf '%s' "${FULLNAME%% *}" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')
        while true; do
            USERNAME_=$(gum input --value "$suggest" --placeholder "Username (lowercase, used to log in)")
            if [[ ! "$USERNAME_" =~ ^[a-z][a-z0-9_-]{0,30}$ ]]; then
                bad "Start with a letter; use lowercase letters, numbers, - or _."
            elif grep -q "^$USERNAME_:" /rofs/etc/passwd 2>/dev/null; then
                bad "\"$USERNAME_\" is a system name. Pick another."
            else break; fi
        done
    fi
    if [ -z "${PASSWORD:-}" ]; then
        say "Your password is used to log in and for admin tasks (sudo)."
        PASSWORD=$(ask_password "Password")
    fi
}

# ---------------------------------------------------------------------
# 6. Disk
# ---------------------------------------------------------------------
live_disk() {   # the USB stick / DVD we're running from: never offered
    local src
    src=$(findmnt -no SOURCE /cdrom 2>/dev/null || true)
    [ -n "$src" ] && lsblk -no PKNAME "$src" 2>/dev/null | head -1
}

largest_free() {   # prints "START END SECTORS" (sectors) of the largest free area on $1
    sfdisk -F "$1" 2>/dev/null | awk 'f && $3>0 {print $1, $2, $3} /^ *Start/{f=1}' | sort -k3 -n | tail -1
}

step_disk() {
    local live disks
    live=$(live_disk || true)
    if [ -z "${DISK:-}" ]; then
        header "Step 6 of 8: Disk"
        disks=$(lsblk -dbnpo NAME,TYPE,SIZE,MODEL | awk -v live="/dev/$live" -v min=$((MIN_DISK_GB*1024*1024*1024)) \
            '$2=="disk" && $1!=live && $1!~/zram|loop/ && $3>=min {
                 model=""; for(i=4;i<=NF;i++) model=model" "$i;
                 printf "%-16s %6.0f GB %s\n", $1, $3/1e9, model}')
        [ -n "$disks" ] || die "No disk of at least $MIN_DISK_GB GB found."
        DISK=$(printf '%s\n' "$disks" | gum choose --header "Install $DISTRO_NAME on which disk?" | awk '{print $1}')
        [ -n "$DISK" ] || exit 1
        echo
        say "What's on $DISK now:"
        lsblk -o NAME,SIZE,FSTYPE,LABEL "$DISK"
        echo
    fi

    if [ -z "${MODE:-}" ]; then
        case $(gum choose --header "How should $DISTRO_NAME use this disk?" \
                "Erase the whole disk" "Use free space (keep Windows / other systems)") in
            "Erase the whole disk") MODE=erase ;;
            "Use free space"*)     MODE=free ;;
            *) exit 1 ;;
        esac
    fi

    if [ "$MODE" = free ]; then
        local free sectors ss
        free=$(largest_free "$DISK")
        ss=$(blockdev --getss "$DISK")
        sectors=$(echo "$free" | awk '{print $3}')
        [ -n "$sectors" ] && [ $((sectors * ss / 1024 / 1024 / 1024)) -ge $MIN_DISK_GB ] \
            || die "Not enough free space on $DISK (need $MIN_DISK_GB GB). In Windows, open Disk Management, shrink the Windows partition, then run the installer again."
        FREE_GB=$((sectors * ss / 1024 / 1024 / 1024))
        ESP=$(lsblk -lnpo NAME,PARTTYPE "$DISK" | awk -v t="$ESP_TYPE" 'tolower($2)==t {print $1; exit}')
        [ -n "$ESP" ] || die "No EFI partition found on $DISK. Use \"Erase the whole disk\" instead."
        # Safety: another Ubuntu-based system uses EFI/ubuntu too; we'd overwrite its boot files.
        local m; m=$(mktemp -d)
        mount -o ro "$ESP" "$m"
        if [ -d "$m/EFI/ubuntu" ]; then
            umount "$m"; die "Another Ubuntu-based system is installed on $DISK. Installing next to it isn't supported (both use the same boot folder)."
        fi
        umount "$m"; rmdir "$m"
    fi
}

# ---------------------------------------------------------------------
# 7. Encryption
# ---------------------------------------------------------------------
step_encrypt() {
    if [ -z "${ENCRYPT:-}" ]; then
        case "$ENCRYPTION" in
            yes) ENCRYPT=yes ;;
            no)  ENCRYPT=no ;;
            *)
                header "Step 7 of 8: Encryption"
                say "Encryption locks the disk with a password, asked every time the PC starts." \
                    "If the laptop is lost or stolen, nobody can read your files." \
                    "If you forget this password, your data can't be recovered."
                if gum confirm "Encrypt the disk?" --default=false; then ENCRYPT=yes; else ENCRYPT=no; fi ;;
        esac
    fi
    if [ "$ENCRYPT" = yes ] && [ -z "${LUKS_PASSWORD:-}" ]; then
        if gum confirm "Use your account password for the disk too?"; then
            LUKS_PASSWORD=$PASSWORD
        else
            LUKS_PASSWORD=$(ask_password "Disk encryption password")
        fi
    fi
}

# ---------------------------------------------------------------------
# 8. Summary and confirmation
# ---------------------------------------------------------------------
step_summary() {
    RAM_GB=$(awk '/MemTotal/{print int($2/1048576 + 0.999)}' /proc/meminfo)
    local disk_desc where
    disk_desc=$(lsblk -dno SIZE,MODEL "$DISK" | xargs)
    if [ "$MODE" = erase ]; then where="ERASE ALL of $DISK ($disk_desc)"
    else where="$FREE_GB GB of free space on $DISK ($disk_desc), keeping everything else"; fi

    local net=connected; [ -n "${NET_SKIP:-}" ] && net="offline (skipped)"
    header "Step 8 of 8: Check your choices"
    gum style --padding "0 2" \
        "Network        $net" \
        "Language       $LOCALE_" \
        "Keyboard       $KEYMAP" \
        "Timezone       $TZ_" \
        "Computer name  $HOSTNAME_" \
        "Your name      ${FULLNAME:-}" \
        "Username       $USERNAME_  (admin rights with sudo)" \
        "Disk           $where" \
        "Encryption     $ENCRYPT" \
        "Hibernation    ${HIBERNATE} (swap file: ${RAM_GB} GB; needs Secure Boot off)"
    echo
    [ "$UNATTENDED" = yes ] && return 0

    case $(gum choose "Install now" "Change my answers" "Quit without changes") in
        "Install now") ;;
        "Change my answers") return 1 ;;
        *) exit 0 ;;
    esac

    if [ "$MODE" = erase ]; then
        gum style --border thick --border-foreground 203 --padding "1 2" \
            "Everything on $DISK ($disk_desc) will be deleted." "This can't be undone."
        [ "$(gum input --placeholder "Type ERASE to continue")" = "ERASE" ] || exit 1
    else
        [ "$(gum input --placeholder "Type INSTALL to continue")" = "INSTALL" ] || exit 1
    fi
}

# ---------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------
partition_erase() {
    wipefs -a "$DISK"
    sgdisk --zap-all "$DISK"
    sgdisk -n1:0:+1G -t1:ef00 -c1:EFI "$DISK"
    if [ "$ENCRYPT" = yes ]; then
        sgdisk -n2:0:+1G -t2:8300 -c2:"$DISTRO_NAME-boot" "$DISK"
        sgdisk -n3:0:0   -t3:8309 -c3:"$DISTRO_NAME" "$DISK"
    else
        sgdisk -n2:0:0   -t2:8300 -c2:"$DISTRO_NAME" "$DISK"
    fi
    partx -u "$DISK" || true; udevadm settle
    ESP=$(partdev "$DISK" 1)
    if [ "$ENCRYPT" = yes ]; then BOOTPART=$(partdev "$DISK" 2); ROOTPART=$(partdev "$DISK" 3)
    else BOOTPART=""; ROOTPART=$(partdev "$DISK" 2); fi
    mkfs.fat -F32 -n EFI "$ESP"
    save ESP "$ESP"; save BOOTPART "$BOOTPART"; save ROOTPART "$ROOTPART"
}

new_partition() {   # create a partition in the largest free area; prints its device
    local before after type=$1 name=$2 size=$3 s e
    before=$(lsblk -lnpo NAME "$DISK")
    read -r s e _ <<<"$(largest_free "$DISK")"
    if [ "$size" = rest ]; then sgdisk -n0:"$s":"$e" -t0:"$type" -c0:"$name" "$DISK" >&2
    else sgdisk -n0:"$s":+"$size" -t0:"$type" -c0:"$name" "$DISK" >&2; fi
    partx -u "$DISK" >&2 || true; udevadm settle
    after=$(lsblk -lnpo NAME "$DISK")
    comm -13 <(echo "$before" | sort) <(echo "$after" | sort) | head -1
}

partition_free() {
    BOOTPART=""
    if [ "$ENCRYPT" = yes ]; then
        BOOTPART=$(new_partition 8300 "$DISTRO_NAME-boot" 1G)
        ROOTPART=$(new_partition 8309 "$DISTRO_NAME" rest)
    else
        ROOTPART=$(new_partition 8300 "$DISTRO_NAME" rest)
    fi
    [ -b "$ROOTPART" ] || return 1
    save BOOTPART "$BOOTPART"; save ROOTPART "$ROOTPART"
}

setup_crypt() {
    printf '%s' "$LUKS_PASSWORD" | cryptsetup luksFormat --type luks2 --batch-mode --key-file=- "$ROOTPART"
    printf '%s' "$LUKS_PASSWORD" | cryptsetup open --key-file=- "$ROOTPART" "$CRYPT_NAME"
    mkfs.ext4 -F -L "$DISTRO_NAME-boot" "$BOOTPART"
}

subvol_path() {   # @ -> /   @home -> /home   @var_log -> /var/log
    case "$1" in
        @) echo / ;;
        @snapshots) echo /.snapshots ;;
        *) echo "/${1#@}" | tr '_' '/' ;;
    esac
}

setup_btrfs() {
    mkfs.btrfs -f -L "$DISTRO_NAME" "$ROOTDEV"
    mount "$ROOTDEV" "$TARGET"
    for sv in $BTRFS_SUBVOLUMES; do btrfs subvolume create "$TARGET/$sv"; done
    umount "$TARGET"
    mount -o "subvol=@,$BTRFS_MOUNT_OPTIONS" "$ROOTDEV" "$TARGET"
    for sv in $BTRFS_SUBVOLUMES; do
        [ "$sv" = @ ] && continue
        local p; p=$(subvol_path "$sv")
        mkdir -p "$TARGET$p"
        if [ "$sv" = @swap ]; then mount -o "subvol=$sv,noatime" "$ROOTDEV" "$TARGET$p"
        else mount -o "subvol=$sv,$BTRFS_MOUNT_OPTIONS" "$ROOTDEV" "$TARGET$p"; fi
    done
    if [ -n "$BOOTPART" ]; then mkdir -p "$TARGET/boot"; mount "$BOOTPART" "$TARGET/boot"; fi
    mkdir -p "$TARGET/boot/efi"
    mount "$ESP" "$TARGET/boot/efi"
}

copy_system() {
    local src=/rofs
    if [ ! -d "$src/usr" ]; then   # fallback: mount the system image from the live media
        src=/run/mipos-src; mkdir -p "$src"
        mount -o loop,ro /cdrom/casper/filesystem.squashfs "$src"
    fi
    rsync -aHAXx --numeric-ids "$src/" "$TARGET/"
}

write_fstab() {
    local fsuuid; fsuuid=$(blkid -s UUID -o value "$ROOTDEV")
    {
        echo "# /etc/fstab: disks mounted at startup (written by mipos-install)"
        for sv in $BTRFS_SUBVOLUMES; do
            local p o; p=$(subvol_path "$sv")
            if [ "$sv" = @swap ]; then o="subvol=$sv,noatime"; else o="subvol=$sv,$BTRFS_MOUNT_OPTIONS"; fi
            printf 'UUID=%s  %-12s btrfs  %s  0 0\n' "$fsuuid" "$p" "$o"
        done
        [ -n "$BOOTPART" ] && printf 'UUID=%s  /boot        ext4   defaults,noatime  0 2\n' "$(blkid -s UUID -o value "$BOOTPART")"
        printf 'UUID=%s  /boot/efi    vfat   umask=0077  0 1\n' "$(blkid -s UUID -o value "$ESP")"
        [ "$HIBERNATE" = yes ] && echo "/swap/swapfile  none  swap  defaults,pri=10  0 0"
        true
    } > "$TARGET/etc/fstab"
    if [ "$ENCRYPT" = yes ]; then
        printf '%s UUID=%s none luks,discard,initramfs\n' "$CRYPT_NAME" "$(blkid -s UUID -o value "$ROOTPART")" > "$TARGET/etc/crypttab"
    else
        : > "$TARGET/etc/crypttab"
    fi
}

make_swapfile() {
    btrfs filesystem mkswapfile --size "${RAM_GB}g" "$TARGET/swap/swapfile"
    save RESUME_OFFSET "$(btrfs inspect-internal map-swapfile -r "$TARGET/swap/swapfile")"
}

configure_system() {
    local fsuuid resume_args=""
    fsuuid=$(blkid -s UUID -o value "$ROOTDEV")
    if [ "$HIBERNATE" = yes ]; then resume_args=" resume=UUID=$fsuuid resume_offset=$RESUME_OFFSET"; fi

    # Saved Wi-Fi / network connections from the live session.
    if compgen -G "/etc/NetworkManager/system-connections/*" >/dev/null; then
        mkdir -p "$TARGET/etc/NetworkManager/system-connections"
        cp -a /etc/NetworkManager/system-connections/. "$TARGET/etc/NetworkManager/system-connections/"
        chmod 600 "$TARGET"/etc/NetworkManager/system-connections/*
    fi

    # Password goes through a private file, never on a command line.
    umask 077
    printf '%s:%s\n' "$USERNAME_" "$PASSWORD" > "$TARGET/root/.mipos-pw"
    umask 022

    cat > "$TARGET/root/mipos-setup.sh" <<EOF
#!/bin/bash
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

# Computer name
echo "$HOSTNAME_" > /etc/hostname
printf '127.0.0.1 localhost\n127.0.1.1 %s\n::1 localhost ip6-localhost ip6-loopback\n' "$HOSTNAME_" > /etc/hosts

# Language, keyboard, timezone
locale-gen "$LOCALE_"
update-locale LANG="$LOCALE_"
sed -i 's/^XKBLAYOUT=.*/XKBLAYOUT="$KEYMAP"/' /etc/default/keyboard
mkdir -p /etc/xdg
printf '[Layout]\nLayoutList=%s\nUse=true\n' "$KEYMAP" > /etc/xdg/kxkbrc
ln -sf "/usr/share/zoneinfo/$TZ_" /etc/localtime
echo "$TZ_" > /etc/timezone

# Remove live-disk-only parts
rm -f /etc/casper.conf /usr/share/applications/mipos-install.desktop /usr/local/sbin/mipos-install
cp /usr/share/mipos/greetd-installed.toml /etc/greetd/config.toml
apt-get purge -y casper gum arch-install-scripts
apt-get autoremove --purge -y

# Your account: admin rights through sudo; the root account stays locked
useradd -m -s /bin/bash -c "$FULLNAME" "$USERNAME_"
for g in $USER_GROUPS; do if getent group "\$g" >/dev/null; then usermod -aG "\$g" "$USERNAME_"; fi; done
chpasswd < /root/.mipos-pw
rm -f /root/.mipos-pw
if [ "$ROOT_LOCKED" = yes ]; then passwd -l root; fi

# Startup system (initrd): only this PC's drivers; resume from hibernation
echo "MODULES=$INITRAMFS_MODULES" > /etc/initramfs-tools/conf.d/mipos.conf
if [ "$HIBERNATE" = yes ]; then
    echo "RESUME=UUID=$fsuuid" > /etc/initramfs-tools/conf.d/resume
else
    echo "RESUME=none" > /etc/initramfs-tools/conf.d/resume
fi
update-initramfs -u -k all

# Bootloader
cat > /etc/default/grub.d/20-mipos-install.cfg <<GRUB
GRUB_CMDLINE_LINUX_DEFAULT="$KERNEL_CMDLINE_EXTRA$resume_args"
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=3
GRUB_DISABLE_OS_PROBER=$([ "$MODE" = free ] && echo false || echo true)
GRUB
# Signed GRUB + shim (works with Secure Boot on). Ubuntu's signed GRUB always
# reads its settings from EFI/ubuntu, so that folder name is required.
grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=ubuntu --uefi-secure-boot
if [ "$MODE" = erase ]; then
    # Fallback copy in EFI/BOOT: starts even if the firmware forgets the boot entry.
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --uefi-secure-boot --removable
fi
update-grub

# Show "$DISTRO_NAME" (not "ubuntu") in the PC's boot menu.
if command -v efibootmgr >/dev/null && efibootmgr >/dev/null 2>&1; then
    for n in \$(efibootmgr | awk '/ ubuntu\t|ubuntu$/ {print substr(\$1,5,4)}'); do efibootmgr -q -b "\$n" -B; done
    efibootmgr -q -c -d "$DISK" -p "\$(cat /sys/class/block/\$(basename "$ESP")/partition)" \
        -L "$DISTRO_NAME" -l '\EFI\ubuntu\shimx64.efi'
fi
EOF
    chmod 700 "$TARGET/root/mipos-setup.sh"
    arch-chroot "$TARGET" /root/mipos-setup.sh
    rm -f "$TARGET/root/mipos-setup.sh" "$TARGET/root/.mipos-pw"
}

do_install() {
    header "Installing $DISTRO_NAME"
    mkdir -p "$TARGET"
    if [ "$MODE" = erase ]; then step "Creating partitions" partition_erase
    else step "Creating partitions in free space" partition_free; fi
    if [ "$ENCRYPT" = yes ]; then
        step "Encrypting the disk" setup_crypt
        ROOTDEV=/dev/mapper/$CRYPT_NAME
    else
        ROOTDEV=$ROOTPART
    fi
    step "Creating Btrfs subvolumes" setup_btrfs
    step "Copying the system (a few minutes)" copy_system
    step "Writing the disk list (fstab)" write_fstab
    if [ "$HIBERNATE" = yes ]; then step "Creating the hibernation swap file (${RAM_GB} GB)" make_swapfile; fi
    step "Setting up your system, user and bootloader" configure_system
    sync
    cleanup
    echo
    gum style --border rounded --border-foreground 114 --padding "1 2" \
        "$DISTRO_NAME is installed." \
        "Remove the USB stick / disc, then restart."
    if [ "$UNATTENDED" = no ] && gum confirm "Restart now?"; then systemctl reboot; fi
}

# ---------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------
if [ "${1:-}" = "--config" ]; then
    [ -f "${2:-}" ] || { echo "Answers file not found: ${2:-}"; exit 1; }
    # shellcheck source=/dev/null
    . "$2"; UNATTENDED=yes
fi

preflight
step_network
while true; do
    step_locale; step_timezone; step_hostname; step_user; step_disk; step_encrypt
    if step_summary; then break; fi
    # "Change my answers": ask again (network stays as it is)
    unset LOCALE_ KEYMAP TZ_ HOSTNAME_ FULLNAME USERNAME_ PASSWORD DISK MODE ENCRYPT LUKS_PASSWORD
done
do_install
