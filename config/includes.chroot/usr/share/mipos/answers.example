# Answers for an unattended install:  sudo mipos-install --config answers.conf
# Copy this file, fill it in, and run the command above.
# WARNING: this installs without asking. MODE=erase wipes DISK completely.
# The passwords are stored in plain text here: use this for test machines only.

NET_SKIP=yes                 # yes = don't try to connect (install offline)
LOCALE_="en_US.UTF-8"
KEYMAP="us"
TZ_="UTC"
HOSTNAME_="mipos"
FULLNAME="Test User"
USERNAME_="test"
PASSWORD="change-me"
DISK="/dev/vda"              # the whole disk, not a partition
MODE="erase"                 # erase | free
ENCRYPT="no"                 # yes | no
LUKS_PASSWORD=""             # only used when ENCRYPT=yes
