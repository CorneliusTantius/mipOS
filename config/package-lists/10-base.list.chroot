# M1: bare minimum system, like a fresh Arch install.
# One package per line.
# The kernel, firmware, power and memory tools come from mipos.conf
# (scripts/10-configure.sh writes them into 05-kernel-firmware.list.chroot).
# casper (live disk startup) is added automatically by live-build.

# Startup and system basics
systemd-sysv
dbus
initramfs-tools
zstd
sudo
locales
tzdata
console-setup
keyboard-configuration
kbd

# CPU fixes for Intel processors
intel-microcode

# Networking (wired and Wi-Fi)
network-manager
wpasupplicant
iproute2
iputils-ping
ca-certificates

# Small everyday command-line tools
nano
less
bash-completion
