# M4: tools for mipos-install, and the bootloader for the installed system.
# The installer copies this whole system to the disk, so everything the
# installed system needs to start (GRUB, encryption, Btrfs) is listed here.

# Installer menus and helpers
gum
arch-install-scripts
rsync

# Disks: partitions, Btrfs, FAT (EFI partition), ext4 (/boot when encrypted)
gdisk
btrfs-progs
dosfstools
e2fsprogs

# Encryption
cryptsetup
cryptsetup-initramfs

# Bootloader (signed versions, so Secure Boot can stay on)
grub-efi-amd64
grub-efi-amd64-signed
shim-signed
efibootmgr
os-prober
