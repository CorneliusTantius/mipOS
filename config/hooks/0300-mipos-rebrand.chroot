#!/bin/sh
# M3: rebrand to mipOS and remove leftover Ubuntu/Canonical messages.
#
# dpkg-divert = tell dpkg "this file is replaced by us": the original is moved
# aside, and Ubuntu updates write to the moved copy, never over our version.
set -e
. /etc/mipos-build.conf

echo "mipOS hook: rebrand"

divert() {
    [ -e "$1" ] || [ -L "$1" ] || return 0
    dpkg-divert --quiet --local --rename --divert "$1.ubuntu" --add "$1"
}

# --- System identity (/usr/lib/os-release, read by almost every program) ---
divert /usr/lib/os-release
cat > /usr/lib/os-release <<EOF
NAME="$DISTRO_NAME"
PRETTY_NAME="$DISTRO_NAME $DISTRO_VERSION"
VERSION="$DISTRO_VERSION (based on Ubuntu $UBUNTU_VERSION)"
VERSION_ID="$DISTRO_VERSION"
ID=$DISTRO_ID
ID_LIKE="ubuntu debian"
VERSION_CODENAME=$UBUNTU_CODENAME
UBUNTU_CODENAME=$UBUNTU_CODENAME
HOME_URL="$DISTRO_URL"
SUPPORT_URL="$DISTRO_URL/issues"
BUG_REPORT_URL="$DISTRO_URL/issues"
LOGO=$DISTRO_ID
EOF
ln -sf ../usr/lib/os-release /etc/os-release

divert /etc/lsb-release
cat > /etc/lsb-release <<EOF
DISTRIB_ID=$DISTRO_NAME
DISTRIB_RELEASE=$DISTRO_VERSION
DISTRIB_CODENAME=$UBUNTU_CODENAME
DISTRIB_DESCRIPTION="$DISTRO_NAME $DISTRO_VERSION"
EOF

# Text shown above the text-mode login.
divert /etc/issue
divert /etc/issue.net
printf '%s %s \\n \\l\n\n' "$DISTRO_NAME" "$DISTRO_VERSION" > /etc/issue
printf '%s %s\n' "$DISTRO_NAME" "$DISTRO_VERSION" > /etc/issue.net

# Ubuntu's legal notice shown at first login.
divert /etc/legal
printf '%s is based on Ubuntu. Each program comes with its own license,\nlisted in /usr/share/doc/*/copyright.\n\n' "$DISTRO_NAME" > /etc/legal

# --- Login messages (motd) that point to Ubuntu or Ubuntu Pro ----------
for f in /etc/update-motd.d/10-help-text /etc/update-motd.d/50-motd-news \
         /etc/update-motd.d/88-esm-announce /etc/update-motd.d/91-contract-ua-esm-status \
         /etc/update-motd.d/91-release-upgrade /etc/update-motd.d/95-hwe-eol; do
    divert "$f"
done
[ -f /etc/default/motd-news ] && sed -i 's/^ENABLED=.*/ENABLED=0/' /etc/default/motd-news

# --- KDE "About this System" page ---------------------------------------
mkdir -p /etc/xdg
cat > /etc/xdg/kcm-about-distrorc <<EOF
[General]
Name=$DISTRO_NAME
Version=$DISTRO_VERSION
Website=$DISTRO_URL
EOF

# --- GRUB menu name on installed systems --------------------------------
mkdir -p /etc/default/grub.d
cat > /etc/default/grub.d/10-mipos.cfg <<EOF
GRUB_DISTRIBUTOR="$DISTRO_NAME"
EOF
