#!/bin/sh
# Lightweight and battery settings, all driven by mipos.conf.
set -e
. /etc/mipos-build.conf

echo "mipOS hook: lightweight tuning"

# --- Memory: zram (compressed swap in RAM) ---------------------------
if [ "$ZRAM" = "yes" ]; then
    cat > /etc/systemd/zram-generator.conf <<EOF
[zram0]
zram-size = $ZRAM_SIZE
compression-algorithm = zstd
EOF
    # Settings that suit zram: swap to compressed RAM early, read one page at a time.
    cat > /etc/sysctl.d/90-mipos-zram.conf <<'EOF'
vm.swappiness = 180
vm.page-cluster = 0
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
EOF
fi

# --- D-Bus: use dbus-broker ------------------------------------------
if [ "$DBUS_BROKER" = "yes" ]; then
    systemctl enable dbus-broker.service
    systemctl --global enable dbus-broker.service
fi

# --- Power: TLP + thermald --------------------------------------------
if [ "$POWER_MANAGER" = "tlp" ]; then
    systemctl enable tlp.service
    # TLP handles radios itself; these would fight with it (TLP's own advice).
    systemctl mask systemd-rfkill.service systemd-rfkill.socket
    mkdir -p /etc/tlp.d
    cat > /etc/tlp.d/01-mipos.conf <<'EOF'
# mipOS: TLP settings. Everything else uses TLP's defaults (already battery-friendly).
CPU_ENERGY_PERF_POLICY_ON_AC=balance_performance
CPU_ENERGY_PERF_POLICY_ON_BAT=power
PLATFORM_PROFILE_ON_AC=balanced
PLATFORM_PROFILE_ON_BAT=low-power
CPU_BOOST_ON_BAT=0
WIFI_PWR_ON_BAT=on
RUNTIME_PM_ON_BAT=auto
USB_AUTOSUSPEND=1
SOUND_POWER_SAVE_ON_BAT=1
NMI_WATCHDOG=0
EOF
fi

# --- System log: keep it small ---------------------------------------
mkdir -p /etc/systemd/journald.conf.d
cat > /etc/systemd/journald.conf.d/10-mipos.conf <<EOF
[Journal]
SystemMaxUse=$JOURNAL_MAX_SIZE
RuntimeMaxUse=$JOURNAL_MAX_SIZE
EOF

# --- Faster shutdown ---------------------------------------------------
mkdir -p /etc/systemd/system.conf.d
cat > /etc/systemd/system.conf.d/10-mipos.conf <<EOF
[Manager]
DefaultTimeoutStopSec=$SERVICE_STOP_TIMEOUT
EOF

# --- Switch off background timers/services we don't want -------------
# "mask" = block it completely, so nothing can start it.
for unit in $DISABLED_UNITS; do
    systemctl mask "$unit"
done
