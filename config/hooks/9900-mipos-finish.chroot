#!/bin/sh
# Last hook: tidy up so the image is small and every boot starts fresh.
set -e
. /etc/mipos-build.conf

# Rebuild the initrd so it includes our casper.conf (live user name).
update-initramfs -u -k all

# Remove files left by the first, minimal stage (before the dpkg strip rules existed).
if [ "$STRIP_DOCS" = "yes" ]; then
    find /usr/share/doc -mindepth 1 ! -type d ! -name copyright -delete
    find /usr/share/doc -mindepth 1 -type d -empty -delete
    rm -rf /usr/share/lintian/*
fi
if [ "$STRIP_MAN" = "yes" ]; then
    rm -rf /usr/share/man/* /usr/share/info/*
fi
if [ "$STRIP_LOCALES" = "yes" ]; then
    for dir in /usr/share/locale/*; do
        name=$(basename "$dir")
        case " $KEEP_LOCALES locale.alias " in
            *" $name "*) ;;          # keep
            *) rm -rf "$dir" ;;
        esac
    done
fi

# Remove downloaded package files and package indexes.
# (Run "sudo apt update" once before installing anything.)
apt-get clean
rm -rf /var/lib/apt/lists/*

# machine-id = a unique ID per computer. Leave it empty so each boot creates its own.
: > /etc/machine-id
rm -f /var/lib/dbus/machine-id

# The copy of mipos.conf was only needed during the build.
rm -f /etc/mipos-build.conf
