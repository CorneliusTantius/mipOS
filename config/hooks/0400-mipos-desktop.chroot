#!/bin/sh
# M2: desktop settings. Trimmed Plasma, greetd login, Flatpak.
set -e
. /etc/mipos-build.conf

echo "mipOS hook: desktop"

PLASMA_CMD="/usr/lib/x86_64-linux-gnu/libexec/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland"

# --- Login: greetd + tuigreet ------------------------------------------
# The live disk logs the live user straight into Plasma ("initial_session").
# mipos-install writes a config without it for installed systems.
mkdir -p /etc/greetd
cat > /etc/greetd/config.toml <<EOF
# mipOS live disk: automatic login. Installed systems get a normal login screen.
[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --asterisks --greeting 'Welcome to $DISTRO_NAME' --cmd '$PLASMA_CMD'"
user = "_greetd"

[initial_session]
command = "$PLASMA_CMD"
user = "$LIVE_USER"
EOF
# Keep the installed-system version ready for the installer.
mkdir -p /usr/share/mipos
cat > /usr/share/mipos/greetd-installed.toml <<EOF
# mipOS: text login screen (tuigreet), then KDE Plasma on Wayland.
[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --asterisks --greeting 'Welcome to $DISTRO_NAME' --cmd '$PLASMA_CMD'"
user = "_greetd"
EOF
systemctl enable greetd.service
systemctl set-default graphical.target

# --- Plasma trims (system-wide defaults in /etc/xdg) -------------------
mkdir -p /etc/xdg
if [ "$PLASMA_DISABLE_BALOO" = "yes" ]; then
    # Baloo = file search indexing. Off: it reads every file in the background.
    printf '[Basic Settings]\nIndexing-Enabled=false\n' > /etc/xdg/baloofilerc
fi
if [ "$PLASMA_EFFECTS" = "animations-no-blur" ]; then
    # Blur and transparency cost the most GPU power. Animations stay on.
    printf '[Plugins]\nblurEnabled=false\ncontrastEnabled=false\n' > /etc/xdg/kwinrc
fi
# Start with an empty desktop instead of reopening last session's apps (faster login).
printf '[General]\nloginMode=emptySession\n' > /etc/xdg/ksmserverrc

# --- Flatpak: Flathub is added through /etc/flatpak/remotes.d (from config/) ---

# --- Live disk: an "Install mipOS" entry in the app menu ---------------
cat > /usr/share/applications/mipos-install.desktop <<EOF
[Desktop Entry]
Type=Application
Name=Install $DISTRO_NAME
Comment=Install $DISTRO_NAME on this computer
Exec=konsole --hide-menubar -e sudo mipos-install
Icon=system-software-install
Terminal=false
Categories=System;
EOF
